			npc_rel[$npcID] += rand(0, 1)
			'<<$npcdesc>> says that you have beautiful hair.'
		else
			npc_rel[$npcID] -= rand(0, 1)
			'<<$npcdesc>> says that you are very beautiful, although he likes bondes.'
