if $ARGS[0] = 'listretrieve2':
	gs 'phone_selfies', 'get_npc_selfie_totals', numnpc

	$temp_table = '<table>'

	if loopmaxev > 0:
		$temp_table += '<tr><th colspan=5>Pictures</th></tr>'
		$temp_table += '<tr></tr><tr>'

		temp_cnum = 0
		lr2_pic_i = 1
		:temp_loopev
			dynamic '$selfie = <<$selfienpc>>photo[<<lr2_pic_i>>]'
			if val($selfie) = 1:
				if temp_cnum = 5: $result += '</tr><tr>' & temp_cnum = 0
				$temp_table += '<td width="20%">' + func('phone_selfies_popup', 'set_selfie2', $photoloc, lr2_pic_i) + '</td>'
				temp_cnum += 1
			end
			lr2_pic_i += 1
		if lr2_pic_i <= loopmax: jump 'temp_loopev'
		if temp_cnum ! 4: $temp_table += '<td></td>'
		$temp_table += '</tr><tr></tr>'

		killvar 'temp_cnum'
		killvar 'lr2_pic_i'
	end

	if loopmax > 0:
		$temp_table += '<tr><th colspan=5>Regular selfies</th></tr>'
		$temp_table += '<tr></tr><tr>'

		temp_cnum = 0
		lr2_regself_i = 1
		:temp_loopselfies
			dynamic '$selfie = <<$selfienpc>>[<<lr2_regself_i>>]'
			if val($selfie) = 1:
				if temp_cnum = 5: $result += '</tr><tr>' & temp_cnum = 0
				$temp_table += '<td width="20%">' + func('phone_selfies_popup', 'set_selfie2', $imgloc, lr2_regself_i) + '</td>'
				temp_cnum += 1
			end
			lr2_regself_i += 1
		if lr2_regself_i <= loopmax: jump 'temp_loopselfies'
		if temp_cnum ! 4: $temp_table += '<td></td>'
		$temp_table += '</tr><tr></tr>'

		killvar 'temp_cnum'
		killvar 'lr2_regself_i'
	end

	if loopmaxsveta > 0:
		$temp_table += '<tr><th colspan=5>Selfies with me</th></tr>'
		$temp_table += '<tr></tr><tr>'

		temp_cnum = 0
		lr2_swm_i = 1
		:temp_loopselfiessveta
			dynamic '$selfie = <<$selfienpc>>sveta[<<lr2_swm_i>>]'
			if val($selfie) = 1:
				if temp_cnum = 5: $result += '</tr><tr>' & temp_cnum = 0
				$temp_table += '<td width="20%">' + func('phone_selfies_popup', 'set_selfie2', '<<$imgloc>>sveta/', lr2_swm_i) + '</td>'
				temp_cnum += 1
			end
			lr2_swm_i += 1
		if lr2_swm_i <= loopmaxsveta: jump 'temp_loopselfiessveta'
		if temp_cnum ! 4: $temp_table += '<td></td>'
		$temp_table += '</tr><tr></tr>'

		killvar 'temp_cnum'
		killvar 'lr2_swm_i'
	end

	if loopmaxsex > 0:
		$temp_table += '<tr><th colspan=5>Sex selfies</th></tr>'
		$temp_table += '<tr></tr><tr>'

		temp_cnum = 0
		lr2_sex_i = 1
		:temp_loopselfiessex
			dynamic '$selfie = <<$selfienpc>>sex[<<lr2_sex_i>>]'
			if val($selfie) = 1:
				if temp_cnum = 5: $result += '</tr><tr>' & temp_cnum = 0
				$temp_table += '<td width="20%">' + func('phone_selfies_popup', 'set_selfie2', '<<$imgloc>>sex/', lr2_sex_i) + '</td>'
				temp_cnum += 1
			end
			lr2_sex_i += 1
		if lr2_sex_i <= loopmaxsex: jump 'temp_loopselfiessex'
		if temp_cnum ! 4: $temp_table += '<td></td>'
		$temp_table += '</tr><tr></tr>'

		killvar 'temp_cnum'
		killvar 'lr2_sex_i'
	end
	$temp_table += '</table>'

	*p $temp_table

	act 'Back': gt 'phone_selfies', 'view_selfies'
	gs 'phone_selfies', 'act_exit'
end


