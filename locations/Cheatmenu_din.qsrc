end

!!----------------------------------------------------------------------------------------------------------------------------
!! Diplomas, Licences, and Certificates
!!----------------------------------------------------------------------------------------------------------------------------

$cheatmenu['documents'] = "gs 'Cheatmenu_din', 'documents'"
if $ARGS[0] = 'documents':
	*clr & cla
	gs 'stat'
	gs 'obj_din', 'cheattabs'
	'<center><h1>Cheat Menu - Diplomas, Licences, and Certificates</h1></center>'
	$cheatmenu['table_start']
	if SchoolAtestat = 0: '<a href="exec:SchoolAtestat = 1 & dynamic $cheatmenu[''documents'']">Get School Certificate</a>'
	if mid($start_type,1,2) = 'sg' and SchoolAtestat = 0: '<font color="red"><b>WARNING!</b></font>: This will end your school year!' & *nl
	if SchoolAtestat = 1:'Already have a School Certificate'
	if university['diploma'] > 0:
		'You already have a Diploma'
	else
		'<a href="exec:gs ''uniutil'', ''diploma'', ''set_obtained'' & dynamic $cheatmenu[''documents'']">Get Diploma</a>'
	end
	if secrdiplom = 0:'<a href="exec:secrdiplom = 1 & dynamic $cheatmenu[''documents'']">Get Secretarial Diploma</a>'
	if secrdiplom = 1:'You already have a Secretarial Diploma'
	if masseuse['certification'] < 10:'<a href="exec:masseuse[''certification''] = 10 & dynamic $cheatmenu[''documents'']">Get Masseuse Certificate</a>'
	if masseuse['certification'] >= 10:'You already have a Masseuse Certificate'
	if prava = 0:'<a href="exec:prava = 1 & dynamic $cheatmenu[''documents'']">Get Driving Licence</a>'
	if prava = 1:'You already have Driving Licence'
	$cheatmenu['table_end']
end

!!----------------------------------------------------------------------------------------------------------------------------
!! Manipulate Time and Weather
!!----------------------------------------------------------------------------------------------------------------------------

$cheatmenu['input_time'] = "gs 'Cheatmenu_din', 'input_time'"
if $ARGS[0] = 'input_time':
	inputtmp = input("Enter time with 4-digit (input 0102 for 1:02)")
	if inputtmp/100 >= 0 and inputtmp/100 <= 23:temp_hour = inputtmp/100
	inputtmp = inputtmp mod 100
	if inputtmp >= 0 and inputtmp <= 59:temp_minut = inputtmp
	killvar 'inputtmp'
	dynamic $cheatmenu['time']
end

$cheatmenu['week'] = "gs 'Cheatmenu_din', 'week'"
if $ARGS[0] = 'week':
	*clr & cla
	gs 'stat'
	'<center><a href="exec:dynamic $cheatmenu[''index'']"><b>Cheat menu</b></a> - <a href="exec:dynamic $cheatmenu[''time'']"><b>Time</b></a></center>'
	*nl
	'Current time: <b><<$week[week]>></b>, <b><<day>></b> of <b><<$month>></b>, <b><<year>></b>, <<$tempcurtime>>'
	'Target time: <b><<$week[temp_week]>></b>, <b><<temp_day>></b> of <b><<$temp_month>></b>, <b><<temp_year>></b>, <<$temptime>>'
	*nl
	'<a href="exec:temp_daystart += 1 - temp_week & dynamic $cheatmenu[''time'']">Monday</a>'
	'<a href="exec:temp_daystart += 2 - temp_week & dynamic $cheatmenu[''time'']">Tuesday</a>'
	'<a href="exec:temp_daystart += 3 - temp_week & dynamic $cheatmenu[''time'']">Wednesday</a>'
	'<a href="exec:temp_daystart += 4 - temp_week & dynamic $cheatmenu[''time'']">Thursday</a>'
	'<a href="exec:temp_daystart += 5 - temp_week & dynamic $cheatmenu[''time'']">Friday</a>'
	'<a href="exec:temp_daystart += 6 - temp_week & dynamic $cheatmenu[''time'']">Saturday</a>'
	'<a href="exec:temp_daystart += 7 - temp_week & dynamic $cheatmenu[''time'']">Sunday</a>'
end

$cheatmenu['month'] = "gs 'Cheatmenu_din', 'month'"
if $ARGS[0] = 'month':
	*clr & cla
	gs 'stat'
	'<center><a href="exec:dynamic $cheatmenu[''index'']"><b>Cheat menu</b></a> - <a href="exec:dynamic $cheatmenu[''time'']"><b>Time</b></a></center>'
	*nl
	'Current time: <b><<$week[week]>></b>, <b><<day>></b>,  of <b><<$month>></b>, <b><<year>></b>, <<$tempcurtime>>'
	'Target time: <b><<$week[temp_week]>></b>, <b><<temp_day>></b>, of <b><<$temp_month>></b>, <b><<temp_year>></b>, <<$temptime>>'
	*nl
	'<a href="exec:dynamic $cheatmenu[''month2''], 1">January</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 2">February</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 3">March</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 4">April</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 5">May</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 6">June</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 7">July</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 8">August</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 9">September</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 10">October</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 11">November</a>'
	'<a href="exec:dynamic $cheatmenu[''month2''], 12">December</a>'
end

$cheatmenu['month2'] = "gs 'Cheatmenu_din', 'month2', $ARGS[0]"
if $ARGS[0] = 'month2':
	gs 'time', 'to_daystart', 1, ARGS[1], temp_year
	temp_daystart = dateVars['daystart']
	dynamic $cheatmenu['time']
end

$cheatmenu['time'] = "gs 'Cheatmenu_din', 'time'"
if $ARGS[0] = 'time':
	gs 'time', 'to_date', temp_daystart
	temp_day = dateVars['day']
	temp_week = dateVars['week']
	temp_month = dateVars['month']
	$temp_month = $dateVars['month_text']
	temp_year = dateVars['year']
	$temp_day_suffix = $dateVars['suffix']
	!! Set transients as gs to emp_functions unreliable for checking day
	gs 'time', 'update_date'
	gs 'outdoors', 'temp_set'
	gs 'stat'

	if currtimecheck = 1:
		killvar 'currtimecheck'
		if currday ! daystart:
			if currday < daystart:
				temp = (week + daystart - currday) mod 7
			else
				temp = week - ((currday - daystart) mod 7)
			end
			currday = daystart
		end
		if currhour < (daystart - 1) * 24 + hour:
			femcycloop = (daystart - 1) * 24 + hour - currhour
			:femcycloop
				gs 'femcyc'
				femcycloop -= 1
			if femcycloop > 0: jump 'femcycloop'
		end
	end
	*clr & cla
	gs 'obj_din', 'cheattabs'
	'<center><h1>Cheat Menu - Manipulate Time and Weather</h1></center>'
	'<center><font color="red"><b>WARNING!</b></font>: Using cheats to manipulate time can <b>easily</b> break quests and cause bugs. Do not use them unless'
	'you know what you''re doing. When reporting bugs, please mention any cheats you used.</center>'
	$cheatmenu['table_start']
	if temp_minut > 9:
		if temp_hour > 9: $temptime = '<b><<temp_hour>>:<<temp_minut>></b>' else $temptime = '<b>0<<temp_hour>>:<<temp_minut>></b>'
	else
		if temp_hour > 9: $temptime = '<b><<temp_hour>>:0<<temp_minut>></b>' else $temptime = '<b>0<<temp_hour>>:0<<temp_minut>></b>'
	end
	if minut > 9:
		if hour > 9: $tempcurtime = '<b><<hour>>:<<minut>></b>' else $tempcurtime = '<b>0<<hour>>:<<minut>></b>'
	else
		if hour > 9: $tempcurtime = '<b><<hour>>:0<<minut>></b>' else $tempcurtime = '<b>0<<hour>>:0<<minut>></b>'
	end

	'Current time: <b><<$week[week]>></b>, <b><<day>><<$day_suffix>></b>, of <b><<$month>></b>, <b><<year>></b>, <<$tempcurtime>>'
	'Target time: <b><<$week[temp_week]>></b>, <b><<temp_day>><<$temp_day_suffix>></b>, of <b><<$temp_month>></b>, <b><<temp_year>></b>, <<$temptime>>'
	'Daychange: <<temp_daystart - daystart>>'
	*nl
	'Year:	<a href="exec:temp_daystart += 365 & dynamic $cheatmenu[''time'']">+1 Year</a>	<a href="exec:temp_daystart -= 365 & dynamic $cheatmenu[''time'']">-1 Year</a>'
	'Select	<a href="exec:dynamic $cheatmenu[''month'']">Month</a>'
	'Select	<a href="exec:dynamic $cheatmenu[''week'']">Weekday</a>'
	$daychange = '	<a href="exec:temp_daystart += 7 & dynamic $cheatmenu[''time'']">+7 Day</a>'
	$daychange += '	<a href="exec:temp_daystart += 1 & dynamic $cheatmenu[''time'']">+1 Day</a>'
	$daychange += '	<a href="exec:temp_daystart -= 1 & dynamic $cheatmenu[''time'']">-1 Day</a>'
	$daychange += '	<a href="exec:temp_daystart -= 7 & dynamic $cheatmenu[''time'']">-7 Day</a>'
	'Day:' +$daychange
	killvar 'daychange'
	$SS = 'Hour: '
	if temp_hour > 0:$SS += '<a href="exec:temp_hour -= 1 & dynamic $cheatmenu[''time'']">-1</a>  ' else $SS += '	'
	if temp_hour > 3:$SS += '<a href="exec:temp_hour -= 4 & dynamic $cheatmenu[''time'']">-4</a>  ' else $SS += '	'
	if temp_hour ! 0:$SS += '<a href="exec:temp_hour = 0 & dynamic $cheatmenu[''time'']">0</a>	' else $SS += '	'
	if temp_hour < 23:$SS += '<a href="exec:temp_hour += 1 & dynamic $cheatmenu[''time'']">+1</a>  ' else $SS += '	'
	if temp_hour < 20:$SS += '<a href="exec:temp_hour += 4 & dynamic $cheatmenu[''time'']">+4</a>'
	$SS
	$SS = 'Minute: '
	if temp_minut > 14:$SS += '<a href="exec:temp_minut -= 15 & dynamic $cheatmenu[''time'']">-15</a> ' else $SS += '	'
	if temp_minut > 0:$SS += '<a href="exec:temp_minut -= 1 & dynamic $cheatmenu[''time'']">-1</a> ' else $SS += '	'
	if temp_minut ! 0:$SS += '<a href="exec:temp_minut = 0 & dynamic $cheatmenu[''time'']">0</a> ' else $SS += '   '
	if temp_minut < 59:$SS += '<a href="exec:temp_minut += 1 & dynamic $cheatmenu[''time'']">+1</a> '
	if temp_minut < 46:$SS += '<a href="exec:temp_minut += 15 & dynamic $cheatmenu[''time'']">+15</a>'
	$SS
	killvar 'SS'
	*nl
	'Weather: <a href="exec:sunWeather=iif(sunWeather=0,1,0) & chWeather = 1 & gs ''outdoors'', ''weather'' & dynamic $cheatmenu[''time'']">'+iif(sunWeather=0,'Rain','Sunny')+'</a>'
	*nl
	'Temperature = <<$temperature>> - <a href="exec:temper += 1 & dynamic $cheatmenu[''time'']">+1 degree</a> - <a href="exec:temper += 5 & dynamic $cheatmenu[''time'']">+5 degrees</a> - <a href="exec:temper -= 1 & dynamic $cheatmenu[''time'']">-1 degree</a> - <a href="exec:temper -= 5 & dynamic $cheatmenu[''time'']">-5 degrees</a>'
	*nl
	'Switch to the <a href="exec:TempUnit = '+iif(TempUnit = 0,'1 & gs ''outdoors'',''weather'' & dynamic $cheatmenu[''time'']">Fahrenheit','0 & gs ''outdoors'',''weather'' & dynamic $cheatmenu[''time'']">Celsius')+'</a> scale'
	*nl
	'<a href="exec:dynamic $cheatmenu[''input_time'']">Direct input time</a>'
	*nl
	'<a href="exec:daystart = temp_daystart & hour = temp_hour & minut = temp_minut & currtimecheck = 1 & dynamic $cheatmenu[''time'']">Accept target date & time</a>'
	'<a href="exec:temp_daystart = daystart & temp_hour = hour & temp_minut = minut & dynamic $cheatmenu[''time'']">Reset target date & time</a>'
	$cheatmenu['table_end']
end

