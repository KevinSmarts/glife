	'Always combed: <a href="exec:								cheatVars[''always_brushed'']		= iif(cheatVars[''always_brushed''], 0, 1)			& dynamic $cheatmenu[$cheatmenu[''this_menu'']]"><<iif(cheatVars[''always_brushed'']		, ''Enabled'', ''Disabled'')>></a>'
