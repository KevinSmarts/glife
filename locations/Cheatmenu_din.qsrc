	Gerpes = 0
	SifacOnce = 0
	Sifilis = 0
	TriperOnce = 0
	Triper = 0
	TriperOral = 0
	KandidozOnce = 0
	Kandidoz = 0
end

$cheatmenu['force_preg'] = "gs 'Cheatmenu_din', 'force_preg'"
if $ARGS[0] = 'force_preg':
	if mesec ! 0: mesec = 0
	if FocH ! 0: FocH = 0
	if EggRH ! 0: EggRH = 0
	if Ovulate ! 0: Ovulate = 0
	if UnfertEgg ! 0: UnfertEgg = 0
	if LutH ! 0: LutH = 0
	if RecovH ! 0: RecovH = 0
	preg = 1
	cycle = 5
	!!Setting implantation date for the due date calculation
	lastovulation = daystart - 5
	PregChem = 150
	$wombthfath = 'A sperm donor'
	babyembryo += 1
	if fertegg = 0:
		Nextbaby = arrsize('$ChildFath')
		Temppolkid = rand(0,1)
		polkid[nextbaby] = Temppolkid
		$kidname[nextbaby] = 'unborn'
		kidage[nextbaby] = 0
		daykid[nextbaby] = 0
		monthkid[nextbaby] = 0
		yearkid[nextbaby] = 0
		Babyptype[nextbaby] = 0
		$ChildFath[nextbaby] = 'A sperm donor'
		$ChildThFath[nextbaby] = 'A sperm donor'
		hairkid[nextbaby] = rand(0, 3)
		eyeskid[nextbaby] = rand(0, 3)
		ChildConType[nextbaby] = 0
		Babyptype[nextbaby] = 1
	else
		fertegg -= 1
	end
end

$cheatmenu['remove_preg'] = "gs 'Cheatmenu_din', 'remove_preg'"
