if $ARGS[0] = 'clotTypePrefTmp':
	if npc_pref_values['clothes_style_wealthy'] > 0:
		if func('pcs_has_attr', 'clothes_style_wealthy'):
			if npc_gentle[$npcID] = 1:
				npc_rel[$npcID] += rand(0, 1)
				'<<$npcdesc>> says, "I like the type of clothing you are wearing <<$pcs_nickname>>. I think girls look amazing in formal clothing."'
			elseif npc_rough[$npcID] = 0:
