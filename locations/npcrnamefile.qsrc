# npcrnamefile

if $ARGS[0] = 'get_nickname':
	if $ARGS[1] = 'rusMale':
		$result = func('npcrnamefile', 'get_nickname', func('npcrnamefile', 'rusMale'))
	elseif $ARGS[1] = 'rusFemale':
		$result = func('npcrnamefile', 'get_nickname', func('npcrnamefile', 'rusFemale'))
!	elseif $ARGS[1] = 'Svetlana':
!		$result = 'Sveta'
	else
		$result = $ARGS[1]
	end
end



