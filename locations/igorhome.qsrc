# igorhome
!2024/08/21
!!Igor = A4
!!igorQW['bottom'] = 1 - Igor has been topped by someone
!!igorQW['bottom'] = 5 - Igor likes being the bottom
!!igorQW['bottom'] = 10 - Igor only wants to be a bottom
!!igorQW['bottom'] = 20 - Igor will be open to letting anyone he "likes" or his romantic partner/BF with benefits to top him

close ALL
if $ARGS[0] = 'entrance':
	$menu_loc = 'igorhome'
	$menu_arg = 'entrance'
	menu_off = 0
	gs 'stat'
	'<center><h4><font color="maroon">Igor Kruglov</font></h4></center>'
	'<center><img <<$set_imgh>> src="images/characters/shared/headshots_main/big4.jpg"></center>'
	if IgorQW['Love'] > 0:
		temprand = rand(1,10)
		if temprand = 1 and fedorKozlovQW >= 10:
			'As you approach Igor, Fedor walks up beside you. "What are you doing with <<$pcs_firstname>>, Igor? You know she''s my girl, right?"'
			'Igor looks surprised before he turns to you, looking sad. "I thought you were <i>my</i> girl?"'
			'Fedor''s eyes narrow and he looks at you as well. "Are you cheating on me?!"'
			'Suddenly caught, you''re not sure what to do. "It''s not what it looks like!"'
			'Fedor''s face hardens. "Then what is it? You''re either cheating on me or you''re not."'

			act 'Say you''re not dating Igor':
				*clr & cla
			IgorQW['Love'] = -1
			IgorQW['Block'] = 1
			IgorQW['Lover'] = -1
				npc_rel['A4'] = 20
				gs 'stat'
				'<center><h4><font color="maroon">Igor Kruglov</font></h4></center>'
				'<center><img <<$set_imgh>> src="images/characters/shared/headshots_main/big5.jpg"></center>'
				'You shake your head at Fedor. "Of course not! We were just goint to study." You glance at Igor and notice he looks sad, but he nods at what you say.'
				'Fedor nods. "Okay... Well you better get going, Igor."'
				'With a distraught expression on his face, Igor takes one last look at you before turning around and walking away.'
				act 'Go with Fedor': gt 'FedorEv', 'Start'
			end

			act 'Say you''re dating Igor':
				*clr & cla
				menu_off = 1
				fedorkozqw = 0
				fedorKozlovQW = 0
				FedorLuv = 0
				fedorkozbreak += 1
				npc_rel['A5'] = 20
				gs 'stat'
				'<center><b><h4><font color="blue"><<"Fyodor [Fedor] Kozlov">></font></h4></b></center>'
				'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/fedor/fedorev/fedorsad.jpg"></center>'
				'You glance at Igor, then at Fedor. "Yes, I''m dating him. I''m sorry."'
				'At first, Fedor looks angry and Igor starts to back up, fearful that Fedor might attack him. Thankfully, Fedor sighs and relaxes, looking rather sad.'
				'"Fine. Go be with him if that''s what you want." He turns and walks away without another word.'
				'Once it''s obvious he''s not going to get his ass kicked, Igor smiles. "Come on. Let''s go to my place."'

				act 'Go to Igor''s house':
					cls
					minut += 15
					gs 'stat'
					'<center><img  src="images/locations/pavlovsk/school/walk_homeb1.jpg"></center>'
					'You follow Igor home. Once you get to his place, he nervously starts scrambling with the keys. He turns to you, nervously laughing...'
					act 'Walk around his home': gt 'igorhome', 'hallway'
					act 'Go to his room': gt 'igorhome', 'igorroom'
				end
		end
	else
			'Igor is waiting for you. "Do you want to come to my house?" he asks eagerly.'

			act 'Go to Igor''s house':
				cls
				minut += 15
				gs 'stat'
				'<center><img  src="images/locations/pavlovsk/school/walk_homeb1.jpg"></center>'
				'You follow Igor home. Once you get to his place, he nervously starts scrambling with the keys. He turns to you, nervously laughing...'
				act 'Walk around his home': gt 'igorhome', 'hallway'
				act 'Go to his room': gt 'igorhome', 'igorroom'
			end
		end
	else
		temprand = rand(1,10)
		if temprand = 1 and fedorKozlovQW >= 10:
			'As you approach Igor, Fedor walks up beside you. "What are you doing with <<$pcs_firstname>>, Igor? You know she''s my girl, right?"'
			'Igor downcasts his eyes. "Oh hey Fedor. We were just going to study... I''ll just be going now."'
			'Fedor nods. "Yeah, that will be for the best. Catch you later, Igor."'
			'Igor takes one last look at you before turning around and walking away.'

			act 'Go with Fedor':
				IgorQW['Love'] = -1
				IgorQW['Block'] = 1
				IgorQW['Lover'] = -1
				gt 'FedorEv', 'Start'
			end
		else
			'Igor is waiting for you. "You ready to go to do homework?" he asks eagerly.'

			act 'Go to Igor''s house':
				cls
				minut += 15
				gs 'stat'
				'<center><img <<$set_imgh>> src="images/locations/pavlovsk/school/walk_homeb1.jpg"></center>'
				'You follow Igor home. Once you get to his place, he unlocks the door and invites you in.'
				act 'Walk around his home': gt 'igorhome', 'hallway'
				act 'Go to his room': gt 'igorhome', 'igorroom'
			end
		end
		act 'You don''t have time today': gt 'gschool_grounds', 'main'
	end
end

