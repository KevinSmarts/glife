if $ARGS[0] = 'igorroom':
	cls
	$menu_loc = 'igorhome'
	$menu_arg = 'igorroom'
	$loc = 'igorhome'
	$loc_arg = 'igorroom'
	menu_off = 0
	minut += 1
	$locclass = 'bedr'
	gs 'igor_schedule'
	gs 'stat'
	'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
	'<center><img <<$set_imgh>> src="images/locations/pavlovsk/resident/igorhome/kom.jpg"></center>'
	'The room is surprisingly clean and organized for a boys room and is fairly tastefully decorated.'
	'In the center of the room against one wall is a single narrow bed. Against the opposite wall is a desk and a chair, with a computer sitting on the desk. Next to the desk is a bookshelf with a fairly large collection of books. Just below the shelves, leaning against the wall, rests a guitar.'
	if DimaLoveIgor > 1: 'Sitting on the bed is a Teddy Bear with a red heart in its little hands.'
	'You see Igor sitting on the edge of his bed.'

	act 'Leave Igor''s room': gt 'igorhome', 'hallway'
	act 'Excuse yourself': gt 'igorhome', 'hallway'
	if lernHome > 0:
		act 'Do your homework together': gt 'igorhome', 'study'
	end
	act 'Chat': gt 'igorhome', 'chat'
	if hour = 23:
		if IgorQW['Lover'] = 1:
			*clr & cla
			'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
			'Igor looks at his watch. "If you stay any later, my mother will come in and make a fuss and talk about how unseemly it is for a boy to have a girl in his room this late."'
			'You nod. "I understand I guess I''ll see you later."'
			act 'Say goodbye and go home': gt 'pav_residential'
			act 'Kiss':
				*clr & cla
				'<center><video autoplay loop src="images/characters/pavlovsk/school/boy/igor/kiss.mp4"></video></center>'
				'You lean in and give him a quick kiss. He''s a bit surprised at first, but then returns it. Once you break the kiss, you leave.'
				act 'Say goodbye and go home': gt 'pav_residential'
			end
		else
			*clr & cla
			'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
			'You look at the clock before saying that it''s really late and that you need to go home.'
			act 'Say goodbye and go home': gt 'pav_residential'
		end
	elseif hour >= 20:
		cls
		'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
		if IgorQW['Lover'] = 1:
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
		end
		if locat['igor'] = 8:
			'Igor looks at his watch. "I want to have fun tonight. Let''s go to the disco!"'
			act 'Agree': minut += 20 & gt 'pav_disco' & !!if they are dating I will add a new version but have not written it yet.
			act 'Decline and go home': gt 'pav_residential'
			act 'Decline and chat instead': gt 'igorhome', 'chat'
		else
			'Igor tells you it''s getting late. You could take the hint and leave or maybe chat just a little longer...'
			act 'Take the hint and go home': gt 'pav_residential'
			act 'Chat just a little longer': gt 'igorhome', 'chat'
		end
	elseif locat['igor'] = 10:
		cls
		'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
		if IgorQW['Lover'] = 1:
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
		end
		'"The others are meeting at the beach right now. Let''s go meet them," he says.'
		act 'Go to the beach with Igor': minut += 15 & gt 'pav_lake', 'school_mates'
		act 'Say you don''t want to go and leave': minut += 5 & gt 'pav_residential'
	end
end

if $ARGS[0] = 'chat':
	*clr & cla
	menu_off = 1
	minut += 5
	gs 'npc_relationship', 'modify', 'A4', 'like', 1, 'home'
	gs 'stat'
	'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
	if IgorQW['Lover'] = 1:
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
	else
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
	end
	if npc_rel['A4'] > 50:
		i = rand(0,10)
	else
		i = rand(0,6)
	end
	*nl
	'You spend some time talking with Igor.'
	*nl
	if i = 0:
		'You talk about school, classes, teachers and how fucked up the system is.'
	elseif i = 1:
		'You talk about what you both want to do after high school.'
	elseif i = 2:
		'You listen as he tells you some interesting local history. You realize that Igor really knows the history of Pavlovsk.'
	elseif i = 3:
		'You both talk about nothing in particular.'
	elseif i = 4:
		'Igor tells you that his parents promised to buy him a new car if he gets into the University.'
	elseif i = 5:
		'You learn from the conversation that Igor''s parents are quite wealthy, owning several businesses and homes around town.'
	elseif i = 6:
		'Igor talks about his older sister. "She buys new clothes every week, but I''m sure she hasn''t worn half of them yet!"'
		sisunlock = 1
	elseif i = 7:
		'You talk about a cute outfit you seen the other day, which leads to a long conversation about girls clothes, a subject in which Igor is surprisingly well versed.'
	elseif i = 8:
		'You talk about makeup and Igor asks you a lot of in depth questions.'
	elseif i = 9:
		'You talk about the boys at school, which turns into you talking about which ones you think are cute. Igor happily joins in, though he thinks Dimka is the cutest boy in school.'
	elseif i = 10:
		IgorQW['bi_curious'] = 1
		'As you talk about various things, Igor suddenly asks what it''s like being a girl. You start telling him and he ends up asking a lot of questions. More than a few of them are sexual in nature, but not in a weird way; he just seems really curious.'
	end
	act 'Keep talking': gt 'igorhome', 'chat'
	act 'Excuse yourself': gt 'igorhome', 'hallway'
	!!this is extra options that show up only if certain things have happened.
	if sisunlock = 1 and IgorQW['eqwtday'] ! daystart:
		act 'Clothes':
			*clr & cla
			'"So your sister has that many clothes?" you ask.'
			'He nods his head vigorously. "Hell yeah, it''s crazy! She has more clothes than some stores!"'
			'You grin at him. "Think I could see them?"'
			'He rolls his eyes. "What is it with girls and clothes? Come on."'
			'He gets up and leads you to his sister''s room.'
			act 'Continue': gt 'igorev', 'din_sisterkom'
		end
	end
	if IgorQW['Lover'] = 1:
		act 'Kiss': gt 'igorev', 'kiss'
		act 'Date':
			*clr & cla
			'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
			if IgorQW['Lover'] = 1:
				'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
			else
				'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
			end
			'"Let''s go see a movie, my treat," he says.'
			act 'Agree': gt 'igorev', 'Movies'
			act 'Decline':
				*clr & cla
				'<center><h4><font color="maroon">Igor''s Room</font></h4></center>'
				if IgorQW['Lover'] = 1:
					'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talkgf.jpg"></center>'
				else
					'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/igor/talk.jpg"></center>'
				end
				'You shake your head. "I''d rather just stay here."'
				'He just nods and smiles.'
				act 'Continue': gt 'igorhome', 'chat'
			end
		end
	end
	if mc_inventory['strapon'] > 0 and IgorQW['strap'] >= 1: act 'Be my bitch': gt 'igorsex', 'strap on'

	!!this only shows up if Sveta knows Igor cross dresses.
	if IgorQW['crossdress'] = 1: act 'Let''s go for walk': gt 'igorev', 'walk'

	!!This one only shows up if Igor went on a date with Dimka.
	if (IgorQW['DimaNos'] = 2 or IgorQW['DimaNos'] = 3) and IgorQW['DimaNos_day'] < daystart: act 'How was your date?': gt 'igorev', 'Ask about Dianas date'
	if IgorQW['Love'] = 1:
		act 'Break up with him':
			*clr & cla
			IgorQW['Love'] = -1
			IgorQW['Block'] = 1
			IgorQW['Lover'] = -1
			minut += 15
			gs 'npc_relationship', 'modify', 'A4', -30
			gs 'stat'
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/boy/artem/artemcry.jpg"></center>'
			'You quietly walk past Igor and enter his room. You sit down on the bed without saying a word.'
			'Igor looks at you questioningly. "What''s wrong, <<$pcs_nickname>>?"'
			'You frown as you look at him. "We need to talk."'
			'His eyes start to water up. "Are you breaking up with me?"'
			'You sigh. "Yes."'
			*nl
			'A tear rolls down his cheek. "Why?"'
			'You get up to put a little space between you. "It''s not you... I just don''t feel the same way about you any more."'
			'he sniffles and takes a deep breath. "Is it someone else?"'
			'You shake your head. "Look, you''re a great guy; I just feel differently now is all."'
			'You talk for a few minutes before he gets up and walks across the room. "I think you should leave, please."'
			'You sigh and nod. "Okay. I''m really sorry."'
			'As you walk out, Igor keeps his back to you. You''re sure that you hear him crying harder as you exit the room.'
			act 'Leave his home': gt 'pav_residential'
		end
	end
end

