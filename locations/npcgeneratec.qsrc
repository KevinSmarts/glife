	npc_apprnc[$ARGS[1]] = npcgeneratecVars['apprnc']
	npc_hotcat[$ARGS[1]] = func('AppearanceSystem', 'ConvertToHotcat', npcgeneratecVars['apprnc'])


	if npc_height[$ARGS[1]] < npcgeneratecVars['av_height'] - 5:
		npcgeneratecVars['body_type'] = 1
		$npc_height_desc[$ARGS[1]] = 'short'
	elseif npc_height[$ARGS[1]] <= npcgeneratecVars['av_height'] + 5:
		npcgeneratecVars['body_type'] = 2
		$npc_height_desc[$ARGS[1]] = 'average'
	else
		npcgeneratecVars['body_type'] = 3
		$npc_height_desc[$ARGS[1]] = 'tall'
	end

	npcgeneratecVars['bmi'] = 100000 * npc_weight[$ARGS[1]] / (npc_height[$ARGS[1]] * npc_height[$ARGS[1]])
	if npcgeneratecVars['gender'] = 0:
		if npcgeneratecVars['bmi'] < 190:
			$npc_build_desc[$ARGS[1]] = 'thin'
		elseif npcgeneratecVars['bmi'] < 225:
			$npc_build_desc[$ARGS[1]] = 'athletic'
		elseif npcgeneratecVars['bmi'] < 250:
			$npc_build_desc[$ARGS[1]] = 'chunky'
		else
			$npc_build_desc[$ARGS[1]] = 'fat'
		end
	else
		if npcgeneratecVars['bmi'] < 190:
			if npcgeneratecVars['body_type'] = 1:
				$npc_build_desc[$ARGS[1]] = 'petite'
			else
				$npc_build_desc[$ARGS[1]] = 'slender'
			end
		elseif npcgeneratecVars['bmi'] < 225:
			$npc_build_desc[$ARGS[1]] = 'toned'
		elseif npcgeneratecVars['bmi'] < 250:
			$npc_build_desc[$ARGS[1]] = 'average'
		else
			$npc_build_desc[$ARGS[1]] = 'chubby'
		end
	end

	if npc_gender[$ARGS[1]] = 1:
		!! A female face
		npcgeneratecVars['rand'] = rand(31, 60)
		$npc_icon[$ARGS[1]] = 'images/system/phone/icons/icon_bf<<npcgeneratecVars[''rand'']>>.png'
		$npc_pic[$ARGS[1]] = 'images/characters/shared/headshots_generic/<<npcgeneratecVars[''rand'']>>.jpg'
	else
		!! A male face
		npcgeneratecVars['rand'] = rand(1, 30)
		$npc_icon[$ARGS[1]] = 'images/system/phone/icons/icon_bf<<npcgeneratecVars[''rand'']>>.png'
		$npc_pic[$ARGS[1]] = 'images/characters/shared/headshots_generic/<<npcgeneratecVars[''rand'']>>.jpg'
	end



end



	!!NOT YET SET
if $ARGS[0] = 'set_other_vars':
	!! set them to sober
	npc_drunk[$ARGS[1]] = 0

	!! Horniness
	npc_horny[$ARGS[1]] = rand(2 * pcs_hotcat, 8 * pcs_hotcat)
	if npcgeneratecVars['gender'] = 1 or npcgeneratecVars['gender'] = 2:
		npc_horny[$ARGS[1]] = max(0, npc_horny[$ARGS[1]] - 20)
	end

	!! initialise lover length in days
	npc_lover_days[$ARGS[1]] = 0
	npc_daygenerated[$ARGS[1]] = daystart

	npc_eventday[$ARGS[1]] = 0
	npc_meetday[$ARGS[1]] = 0
	npc_meethour[$ARGS[1]] = 0
	npc_dates[$ARGS[1]] = 0

	!! How compliant the npc is. Positive: compliant with Sveta. Negative: Sveta is compliant with npc.
	npc_compliance[$ARGS[1]] = 0

	!!	if npc_lover_keys = 1: the player has keys to their apartment and can access it whenever they want
	npc_lover_keys[$ARGS[1]] = 0

	!! Quest stage, relationship and love initialised
	npc_QW[$ARGS[1]] = 0
		!! hornguy6 commentary: I don''t know why relationship automatically starts at 40? I didn''t code this part so maybe someone can explain the reasoning behind it.
		!! anjuna explenation: It means that the npc starts friendly
	npc_rel[$ARGS[1]] = 40
	npc_love[$ARGS[1]] = 0

	!! times you have had sex with and pervert level of npc
	npc_sex[$ARGS[1]] = 0
	npc_perv[$ARGS[1]] = 0

	!! STDs set to 0. For characters with a STD, you need to gs npcgenext rstd
	npc_herpes[$ARGS[1]] = 0
	npc_syth[$ARGS[1]] = 0
	npc_gon[$ARGS[1]] = 0
	npc_thrush[$ARGS[1]] = 0


	! {Creating the DNA of the character. If it is someone specific, like father, mother, daughter, sone, etc. then should be overwritten.}
	$npc_dna[$ARGS[1]] = func('DNA', 'create')
end


if $ARGS[0] = 'cleanup':
	!! Variable clean up
	killvar 'npcgeneratecVars'
	killvar '$npcgeneratecVars'
end



--- npcgeneratec ---------------------------------
