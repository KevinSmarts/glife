# npcgeneratec

!! This file requires the sex, name and age for the npc to be generated
!! You can also set their approx. home location
!! All data produced is random so if you need a specific value you will have to overwrite it


if $ARGS[0] = '':
	!! npcgen_lastrun is a flag to help track whether npcgeneratec or npcpreservec has been run last
	!! npcgeneratec is 1
	!! npcpreservec is 2
	npcgen_lastrun = 1

	!! sets sex, 0 male, 1 female, 2 female herm, 3 male herm
	npcgeneratecVars['gender'] = ARGS[0]

	!! npc age
	if ARGS[2] ! 0:
		npcgeneratecVars['age'] = ARGS[2]
	else
		npcgeneratecVars['age'] = rand(18, 35)
	end


	!! Name for npc, can just be rapist or shop assistant, etc
	if $ARGS[1] ! '':
		$npcgeneratecVars['name'] = $ARGS[1]
	else
		if npcgeneratecVars['gender'] = 0:
			$npcgeneratecVars['name'] = 'A Male'
		elseif npcgeneratecVars['gender'] = 1:
			$npcgeneratecVars['name'] = iif(npcgeneratecVars['age'] <= 25, 'A Girl', 'A Woman')
		elseif npcgeneratecVars['gender'] = 2:
			$npcgeneratecVars['name'] = iif(npcgeneratecVars['age'] <= 25, 'A Girl', 'A Woman')
		else
			$npcgeneratecVars['name'] = 'A Male'
		end
	end

	!! npc home location area
	!! 1 - Pavlovsk Residential Area
	!! 2 - Student dorms in the city
	!! 3 - St. Petersburg Residential Area
	!! 4 - St. Petersburg City Center
	if ARGS[3] ! 0:
		npcgeneratecVars['loc'] = ARGS[3]
	else
		if $region = 'pav':
			npcgeneratecVars['loc'] = 1
		elseif $region = 'city':
			npcgeneratecVars['loc'] = rand(3, 4)
		end
	end

	npcgeneratecVars['anonymous'] = ARGS[4]

	!! For example
	!! gs 'npcgeneratec', 0, 'stranger', rand(18,45), 3, 1
	!! Which would generate a male named stranger between ages of 18 and 45 who lives in the St. Petersburg Residential Area who will be remembered as ''stranger''

	gs 'npcgeneratec', 'init'
end



if $ARGS[0] = 'init':
	gs 'npcgeneratec', 'assign_index'
	gs 'npcgeneratec', 'assign_dob', $npclastgenerated
	gs 'npcgeneratec', 'assign_stats', $npclastgenerated
	gs 'npcgeneratec', 'set_details', $npclastgenerated

	gs 'npcgeneratec', 'set_lifestyle', $npclastgenerated
	gs 'npcgeneratec', 'set_personality', $npclastgenerated
	gs 'npcgeneratec', 'set_apprnc', $npclastgenerated
	gs 'npcgeneratec', 'set_other_vars', $npclastgenerated

	gs 'npcgeneratec', 'cleanup'
end



if $ARGS[0] = 'assign_index':
	!! This sets up a newly generated index number by overwriting the first blank number
	!! The first check is to see if array 0 in the cleanup list is available and overwrites it if it is free
	if mid($cemptyarray[0],1,1) = 'C':
		$npclastgenerated = $cemptyarray[0]
		killvar '$cemptyarray', 0
	else
		:npcgencsanityloop
			ngc_scheck = 0
			$npclastgenerated = 'C' + '<<carraynumber>>'
			$npcgeneratecVars['npcID'] = 'C' + '<<carraynumber-1>>'
			if $npc_perstype[$npcgeneratecVars['npcID']] = '' and carraynumber > 0:
				carraynumber -= 1
				ngc_scheck = 1
			elseif $npc_perstype[$npclastgenerated] = '':
				ngc_scheck = 0
			else
				carraynumber += 1
				ngc_scheck = 1
			end
		if ngc_scheck = 1: jump 'npcgencsanityloop'
		killvar 'ngc_scheck'
	end
	carraynumber += 1

	$npc_index[$npclastgenerated] = $npclastgenerated
end



if $ARGS[0] = 'assign_dob':
	!! Random birthday based on age given

	!! npc reached age exactly 1 year ago
	gs 'time', 'to_daystart', day, month, year - npcgeneratecVars['age'] - 1
	npcgeneratecVars['min_daystart'] = dateVars['daystart'] + 1

	npcgeneratecVars['birth_daystart'] = rand(npcgeneratecVars['min_daystart'], npcgeneratecVars['min_daystart'] + 364)
	gs 'time', 'to_date', npcgeneratecVars['birth_daystart']

	npc_dob[$ARGS[1]]  = dateVars['year']  * 10000
	npc_dob[$ARGS[1]] += dateVars['month'] * 100
	npc_dob[$ARGS[1]] += dateVars['day']

	! {we save the unique number of the npc, to be able to get the index of the array via arrpos}
end



if $ARGS[0] = 'assign_stats':
	!! Sets a seed value for the stat randomization as well as calculate chance of virginity
	if npcgeneratecVars['age'] < 18:
		npcgeneratecVars['virgin'] = rand(0, 20)
		npcgeneratecVars['mind'] = rand(20, 40)
		npcgeneratecVars['body'] = rand(40, 60)
	elseif npcgeneratecVars['age'] < 22:
		npcgeneratecVars['virgin'] = rand(10, 22)
		npcgeneratecVars['mind'] = rand(25, 45)
		npcgeneratecVars['body'] = rand(35, 55)
	elseif npcgeneratecVars['age'] < 30:
		npcgeneratecVars['virgin'] = rand(19, 24)
		npcgeneratecVars['mind'] = rand(30, 50)
		npcgeneratecVars['body'] = rand(30, 50)
	elseif npcgeneratecVars['age'] < 35:
		npcgeneratecVars['virgin'] = rand(19, 26)
		npcgeneratecVars['mind'] = rand(35, 55)
		npcgeneratecVars['body'] = rand(25, 45)
	else
		npcgeneratecVars['virgin'] = rand(19, 30)
		npcgeneratecVars['mind'] = rand(40, 60)
		npcgeneratecVars['body'] = rand(20, 40)
	end

	temp_statmin = min(npcgeneratecVars['age'] / 2, 20)
	npc_stren[$ARGS[1]]		= rand(temp_statmin, npcgeneratecVars['body'])
	npc_agil[$ARGS[1]]		= rand(temp_statmin, npcgeneratecVars['body'])
	npc_vital[$ARGS[1]]		= rand(temp_statmin, npcgeneratecVars['body'])

	npc_intel[$ARGS[1]]		= rand(temp_statmin, npcgeneratecVars['mind'])
	npc_prcptn[$ARGS[1]]	= rand(temp_statmin, npcgeneratecVars['mind'])
	npc_react[$ARGS[1]]		= rand(temp_statmin, npcgeneratecVars['mind'])

	npc_chrsm[$ARGS[1]]		= rand(npcgeneratecVars['body'] / 2, npcgeneratecVars['mind'])
	npc_sprt[$ARGS[1]]		= rand(npcgeneratecVars['body'] / 2, npcgeneratecVars['mind'])
	npc_magik[$ARGS[1]]		= 0


	!! Flag for virginity
	if npcgeneratecVars['virgin'] < 20:
		npc_sexskill[$ARGS[1]] = 0
	else
		npc_sexskill[$ARGS[1]] = rand(1, 100)
	end
	silaVag = npc_sexskill[$ARGS[1]]
end



if $ARGS[0] = 'set_details':
	!! Fill details about their sex such as cock and breast size
	if npcgeneratecVars['gender'] = 0:
		! {Male}
		$npcgeneratecVars['firstname'] = func('npcrnamefile', 'rusMale')
		gs 'npcgeneratec', 'gen_dick', $ARGS[1]
		npc_gender[$ARGS[1]] = 0
		npcgeneratecVars['av_height'] = 175
		npc_height[$ARGS[1]] = npcgeneratecVars['av_height'] + rand(-15, 15)
		npcgeneratecVars['av_weight'] = 68
		npc_weight[$ARGS[1]] = npcgeneratecVars['av_weight'] + rand(-23, 23)
		npc_spermpot[$ARGS[1]] = 10000
		$npc_notes[$ARGS[1]] = 'A male.'
		npc_bust[$ARGS[1]] = 0
	elseif npcgeneratecVars['gender'] = 1:
		! {Female}
		$npcgeneratecVars['firstname'] = func('npcrnamefile', 'rusFemale')
		npc_gender[$ARGS[1]] = 1
		npcgeneratecVars['av_height'] = 165
		npc_height[$ARGS[1]] = npcgeneratecVars['av_height'] + rand(-15, 15)
		npcgeneratecVars['av_weight'] = 60
		npc_weight[$ARGS[1]] = npcgeneratecVars['av_weight'] + rand(-21, 21)
		npc_spermpot[$ARGS[1]] = -1
		$npc_thdick[$ARGS[1]] = 'clitoris'
		npc_dick[$ARGS[1]] = rand(0, 1)
		$npc_notes[$ARGS[1]] = 'A female.'
		!!0 - 60  curve around 22,5 (C/D cups)
		npc_bust[$ARGS[1]] = rand(0, 15) + rand(0, 15) + rand(0, 15)
		if rand(0, 9) = 0: npc_bust[$ARGS[1]] += rand(0, 15)
	elseif npcgeneratecVars['gender'] = 2:
		! {HermFemale}
		$npcgeneratecVars['firstname'] = func('npcrnamefile', 'rusFemale')
		gs 'npcgeneratec', 'gen_dick', $ARGS[1]
		npc_gender[$ARGS[1]] = 1
		npcgeneratecVars['av_height'] = 165
		npc_height[$ARGS[1]] = npcgeneratecVars['av_height'] + rand(-15, 15)
		npcgeneratecVars['av_weight'] = 60
		npc_weight[$ARGS[1]] = npcgeneratecVars['av_weight'] + rand(-21, 21)
		npc_spermpot[$ARGS[1]] = -1
		$npc_thdick[$ARGS[1]] = 'clitoris'
		$npc_notes[$ARGS[1]] = 'A female Hermaphrodite.'
		!!0 - 60  curve around 22,5 (C/D cups)
		npc_bust[$ARGS[1]] = rand(0, 15) + rand(0, 15) + rand(0, 15)
	else
		! {HermMale}
		$npcgeneratecVars['firstname'] = func('npcrnamefile', 'rusMale')
		gs 'npcgeneratec', 'gen_dick', $ARGS[1]
		npc_gender[$ARGS[1]] = 0
		npcgeneratecVars['av_height'] = 175
		npc_height[$ARGS[1]] = npcgeneratecVars['av_height'] + rand(-15, 15)
		npcgeneratecVars['av_weight'] = 68
		npc_weight[$ARGS[1]] = npcgeneratecVars['av_height'] + rand(-15, 15)
		npc_spermpot[$ARGS[1]] = 10000
		$npc_notes[$ARGS[1]] = 'A male Hermaphrodite.'
		npc_bust[$ARGS[1]] = rand(0, 10)
	end

	$npcgeneratecVars['nickname'] = func('npcrnamefile', 'get_nickname', $npcgeneratecVars['firstname'])
	$npcgeneratecVars['lastname'] = func('npcrnamefile', 'rusSur')
	!! Hair colour
	npc_haircol[$ARGS[1]] = rand(0, 3)

	$npc_firstname[$ARGS[1]] = $npcgeneratecVars['firstname']
	$npc_nickname[$ARGS[1]] = $npcgeneratecVars['nickname']
	$npc_lastname[$ARGS[1]] = $npcgeneratecVars['lastname']
	if npcgeneratecVars['anonymous'] = 0 or $npcgeneratecVars['name'] = '':
		$npc_usedname[$ARGS[1]] = $npcgeneratecVars['firstname']
	else
		$npc_usedname[$ARGS[1]] = $npcgeneratecVars['name']
	end
end


if $ARGS[0] = 'gen_dick':
	npcgeneratecVars['dick_length'] = 0
	if ARGS[2] > 0: npcgeneratecVars['dick_length'] += ARGS[2]

	npcgeneratecVars['rand'] = rand(1, 10000)
	if npcgeneratecVars['rand'] < 15:
		npcgeneratecVars['dick_length'] += rand(5, 6)
	elseif npcgeneratecVars['rand'] < 250:
		npcgeneratecVars['dick_length'] += rand(7, 8)
	elseif npcgeneratecVars['rand'] < 1600:
		npcgeneratecVars['dick_length'] += rand(9, 10)
	elseif npcgeneratecVars['rand'] < 5000:
		npcgeneratecVars['dick_length'] += rand(11, 13)
	elseif npcgeneratecVars['rand'] < 8400:
		npcgeneratecVars['dick_length'] += rand(13, 15)
	elseif npcgeneratecVars['rand'] < 9750:
		npcgeneratecVars['dick_length'] += rand(16, 17)
	elseif npcgeneratecVars['rand'] < 9985:
		npcgeneratecVars['dick_length'] += rand(18, 19)
	elseif npcgeneratecVars['rand'] < 9999:
		npcgeneratecVars['dick_length'] += rand(20, 21)
	else
		npcgeneratecVars['dick_length'] += rand(22, 30)
	end

	! It sets the girth based on the dick size
	if npcgeneratecVars['dick_length'] < 9:
		npcgeneratecVars['dick_girth'] = 10
	elseif npcgeneratecVars['dick_length'] < 12:
		npcgeneratecVars['dick_girth'] = 11
	elseif npcgeneratecVars['dick_length'] < 15:
		npcgeneratecVars['dick_girth'] = 12
	elseif npcgeneratecVars['dick_length'] < 18:
		npcgeneratecVars['dick_girth'] = 12
	elseif npcgeneratecVars['dick_length'] < 21:
		npcgeneratecVars['dick_girth'] = 12
	elseif npcgeneratecVars['dick_length'] < 24:
		npcgeneratecVars['dick_girth'] = 13
	else
		npcgeneratecVars['dick_girth'] = 14
	end

	! Then it gives random variance with girth. 1 or 2 drops a size. 3 or 4 stays the same. 5 or 6 goes up a size. A 1 or a 6 gives a chance to go up or down a size again, for a max of 2 changes from the base girth from size.
	npcgeneratecVars['rand'] = rand(1, 6)
	if npcgeneratecVars['rand'] <= 2:
		npcgeneratecVars['dick_girth'] -= 1
	elseif npcgeneratecVars['rand'] >= 5:
		npcgeneratecVars['dick_girth'] += 1
	end

	if npcgeneratecVars['rand'] = 1 or npcgeneratecVars['rand'] = 6:
		npcgeneratecVars['rand'] = rand(1, 3)
		if npcgeneratecVars['rand'] = 1:
			npcgeneratecVars['dick_girth'] -= 1
		elseif npcgeneratecVars['rand'] = 3:
			npcgeneratecVars['dick_girth'] += 1
		end
	end

	npc_dick[$ARGS[1]] = npcgeneratecVars['dick_length']
	npc_girth[$ARGS[1]] = npcgeneratecVars['dick_girth']

	! Then it returns the official girth.
	if npcgeneratecVars['dick_girth'] < 2:
		$npc_thdick[$ARGS[1]] = 'skinny'
	elseif npcgeneratecVars['dick_girth'] = 2:
		$npc_thdick[$ARGS[1]] = 'slim'
	elseif npcgeneratecVars['dick_girth'] = 3:
		$npc_thdick[$ARGS[1]] = 'well proportioned'
	elseif npcgeneratecVars['dick_girth'] = 4:
		$npc_thdick[$ARGS[1]] = 'thicker than average'
	elseif npcgeneratecVars['dick_girth'] = 5:
		$npc_thdick[$ARGS[1]] = 'thick'
	elseif npcgeneratecVars['dick_girth'] = 6:
		$npc_thdick[$ARGS[1]] = 'massive'
	else
		$npc_thdick[$ARGS[1]] = 'monstrous'
	end


	!!	$npc_dick_desc is set here
	!!	this variable is to set a shorthand method of checking dick size without looking for specific numbers
	!!	it is organized by length and then ascending girth
	!!	$npc_dick_class is a fast way of determining size by category

	!! short dicks
	if npcgeneratecVars['dick_length'] < 9:
		$npc_dick_class[$ARGS[1]] = 'short'
		if npcgeneratecVars['dick_girth'] <= 2:
			$npc_dick_desc[$ARGS[1]] = 'tiny'
		elseif npcgeneratecVars['dick_girth'] <= 4:
			$npc_dick_desc[$ARGS[1]] = 'short'
		else
			$npc_dick_desc[$ARGS[1]] = 'chode'
		end

	!! average length dicks
	elseif npcgeneratecVars['dick_length'] < 15:
		$npc_dick_class[$ARGS[1]] = 'average'
		if npcgeneratecVars['dick_girth'] <= 2:
			$npc_dick_desc[$ARGS[1]] = 'skinny'
		elseif npcgeneratecVars['dick_girth'] <= 4:
			$npc_dick_desc[$ARGS[1]] = 'normal'
		else
			$npc_dick_desc[$ARGS[1]] = 'thick'
		end

	!! long dicks
	elseif npcgeneratecVars['dick_length'] < 20:
		$npc_dick_class[$ARGS[1]] = 'big'
		if npcgeneratecVars['dick_girth'] <= 2:
			$npc_dick_desc[$ARGS[1]] = 'long'
		elseif npcgeneratecVars['dick_girth'] <= 4:
			$npc_dick_desc[$ARGS[1]] = 'huge'
		else
			$npc_dick_desc[$ARGS[1]] = 'enormous'
		end

	!! extremely long dicks
	else
		$npc_dick_class[$ARGS[1]] = 'extra_big'
		if npcgeneratecVars['dick_girth'] <= 2:
			$npc_dick_desc[$ARGS[1]] = 'lengthy'
		elseif npcgeneratecVars['dick_girth'] <= 4:
			$npc_dick_desc[$ARGS[1]] = 'gigantic'
		else
			$npc_dick_desc[$ARGS[1]] = 'monster'
		end
	end
end



if $ARGS[0] = 'set_lifestyle':
	!!	Set home details

	!!	npc_apt_type = 1: student dorm (only available in the city for obvious reasons)
	!!	npc_apt_type = 2: studio apartment
	!!	npc_apt_type = 3: one bedroom apartment
	!!	npc_apt_type = 4: multi-bedroom apartment with roommates
	!!	npc_apt_type = 5: multi-bedroom apartment living alone
	!!	npc_apt_type = 6: high rise apartment (for rich people only)

	!!	npcgeneratecVars['loc']
	!!	1 - Pavlovsk Residential Area
	!!	2 - Student dorms in the city
	!!	3 - St. Petersburg Residential Area
	!!	4 - St. Petersburg City Center

	!!	occupation set, list below
	npcgeneratecVars['occupation'] = 0

	npcgeneratecVars['loc'] = npcgeneratecVars['loc']
	if npcgeneratecVars['loc'] = 1:
		$npc_residence[$ARGS[1]] = 'pav_residential'
		npc_finance[$ARGS[1]] = rand(0, 1)
	elseif npc_resnpcgeneratecVars['loc'] = 2:
		$npc_residence[$ARGS[1]] = 'uni_grounds'
		npc_finance[$ARGS[1]] = 0
	elseif npcgeneratecVars['loc'] = 3:
		$npc_residence[$ARGS[1]] = 'city_residential'
		npc_finance[$ARGS[1]] = rand(1, 2)
	else
		$npc_residence[$ARGS[1]] = 'city_center'
		npc_finance[$ARGS[1]] = 2
	end


	if npc_finance[$ARGS[1]] = 0:
		npcgeneratecVars['rand'] = rand(0, 2)
		if npcgeneratecVars['rand'] = 0:
			npc_start_free_time[$ARGS[1]] = 8
			npc_end_free_time[$ARGS[1]] = 12

			npc_work_start[$ARGS[1]] = 13
			npc_work_end[$ARGS[1]] = 21

		elseif npcgeneratecVars['rand'] = 1:
			npc_start_free_time[$ARGS[1]] = 15
			npc_end_free_time[$ARGS[1]] = 20

			npc_work_start[$ARGS[1]] = 6
			npc_work_end[$ARGS[1]] = 14
		else
			npc_start_free_time[$ARGS[1]] = 18
			npc_end_free_time[$ARGS[1]] = 22

			npc_work_start[$ARGS[1]] = 9
			npc_work_end[$ARGS[1]] = 17
		end

		if $npc_residence[$ARGS[1]] ! 'pav_residential' and $npc_residence[$ARGS[1]] ! 'city_center' and npcgeneratecVars['age'] < 28:
			npc_student[$ARGS[1]] = rand(0, 1)
			npc_apt_type[$ARGS[1]] = rand(1, 4)
		elseif $npc_residence[$ARGS[1]] = 'uni_grounds':
			npc_student[$ARGS[1]] = 1
			npc_apt_type[$ARGS[1]] = 2
		else
			npc_apt_type[$ARGS[1]] = rand(2, 4)
		end
		npcgeneratecVars['occupation'] = rand(1, 7)

		npc_day_off[$ARGS[1]] = rand(1, 7)

	elseif npc_finance[$ARGS[1]] = 1:
		if rand(0, 1) = 0:
			npc_start_free_time[$ARGS[1]] = 8
			npc_end_free_time[$ARGS[1]] = 12

			npc_work_start[$ARGS[1]] = 13
			npc_work_end[$ARGS[1]] = 21
		else
			npc_start_free_time[$ARGS[1]] = 18
			npc_end_free_time[$ARGS[1]] = 22

			npc_work_start[$ARGS[1]] = 9
			npc_work_end[$ARGS[1]] = 17
		end

		npc_apt_type[$ARGS[1]] = rand(2, 5)
		npcgeneratecVars['occupation'] = rand(7, 15)
		npc_car[$ARGS[1]] = rand(-3, 1)

	elseif npc_finance[$ARGS[1]] = 2:
		if rand(0, 1) = 0:
			npc_start_free_time[$ARGS[1]] = 8
			npc_end_free_time[$ARGS[1]] = 12

			npc_work_start[$ARGS[1]] = 13
			npc_work_end[$ARGS[1]] = 21
		else
			npc_start_free_time[$ARGS[1]] = 18
			npc_end_free_time[$ARGS[1]] = 22

			npc_work_start[$ARGS[1]] = 9
			npc_work_end[$ARGS[1]] = 17
		end

		npc_apt_type[$ARGS[1]] = rand(5, 6)
		npcgeneratecVars['occupation'] = rand(14, 19)
		npc_car[$ARGS[1]] = rand(0, 1)
	end

	!! failsafe until possibility of roommates is sorted out
	if npc_apt_type[$ARGS[1]] = 4: npc_apt_type[$ARGS[1]] = 5
	!! apt_type 6 is disabled until pictures are added
	if npc_apt_type[$ARGS[1]] = 6: npc_apt_type[$ARGS[1]] = 5

	npc_day_off[$ARGS[1]] = rand(1,7)

	!!	npc_style[$ARGS[1]] determines generally how they dress and what their "persona" is
	!!	Each style is limited by their financial status and occupation
	!!	e.g. You can''t have someone who dresses like a businessman but works as a line cook
	!!	1 - "normal"
	!!	2 - Gopnik
	!!	3 - nerdy
	!!	4 - sporty
	!!	5 - fashionable
	!!	6 - businessman

	if npcgeneratecVars['occupation'] < 15:
		npc_style[$ARGS[1]] = rand(1,5)
	else
		npc_style[$ARGS[1]] = (rand(2,6) mod 6) + 1
	end

	if npc_style[$ARGS[1]] = 1:
		$npc_outfit[$ARGS[1]] = 'jeans and a ' + iif(npc_gender[$ARGS[1]] = 0, 'sweater', 'blouse')
	elseif npc_style[$ARGS[1]] = 2:
		$npc_outfit[$ARGS[1]] = 'a tracksuit'
	elseif npc_style[$ARGS[1]] = 3:
		$npc_outfit[$ARGS[1]] = 'jeans and a ' + iif(rand(0, 1), 't.A.T.u', 'Tetris') + 'shirt'
	elseif npc_style[$ARGS[1]] = 4:
		$npc_outfit[$ARGS[1]] = iif(npc_gender[$ARGS[1]] = 0, 'jogging', 'hot') + ' pants and a tanktop'
	elseif npc_style[$ARGS[1]] = 5:
		$npc_outfit[$ARGS[1]] = 'a fashionable ' + iif(npc_gender[$ARGS[1]] = 0, 'suit', 'dress')
	else
		$npc_outfit[$ARGS[1]] = 'an expensive ' + iif(npc_gender[$ARGS[1]] = 0, 'suit', 'dress')
	end


	$npcgeneratecVars['home_path'] = 'images/shared/romance/lovers/homes'

	if npc_apt_type[$ARGS[1]] = 6:
		!! high rise

		!! this is to determine what their spare room is used for based on their personality type
		if npc_style[$ARGS[1]] = 3:
			npcgeneratecVars['spare_room'] = 1
		elseif npc_style[$ARGS[1]] = 2 or npc_style[$ARGS[1]] = 4:
