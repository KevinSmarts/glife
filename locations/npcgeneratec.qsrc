	!! 	if npc_mj = 2: they are a stoner
	!!	20% chance they will smoke weed at all, 5% chance total of being either a stoner
	if rand(0, 5) = 0: npc_mj[$ARGS[1]] = 1 + (rand(0, 3) / 3)

