# wakeup

!! Deals with all the triggers that happen when waking up.
!!
!! Moved here from sleep or sleep_events
!! When done: Move to wakeup_events

if $ARGS[0] = 'start' or $ARGS[0] = 'wake' or $ARGS[0] = '':
	menu_off = 1
	InSleep = 1
	gs 'stat'

	SleepVars['no_sleep_loss'] = 1

	xgt 'wakeup', 'mod_sleeptriggers'
end

if $ARGS[0] = 'mod_sleeptriggers':
	!! This location is here to allow mods to hook into the system.
	!! Check for: if $ARGS[0] = 'pre_sleep' and $ARGS[1] = 'mod_sleeptriggers'
	!!
	!! This is NOT for events!!

	gs 'LOCA', 'wakeup', 'mod_sleeptriggers'
	xgt 'wakeup_events', 'start'
end


if $ARGS[0] = 'get_out':
	menu_off = 1
	sleepVars['time_now'] = daystart * 1440 + hour * 60 + minut
	if sleepVars['slept_in'] = 1:
		'You wake up at <b><<func(''time'', ''get_time_string'',  hour,  minut, cheatVars[''time_format''])>></b>, after sleeping-in a little longer than planned, but at least you''ve had plenty of sleep.'
	elseif pcs_sleep >= 100 and alarmVars['alarmOn'] = 1 and sleepVars['time_now'] >= sleepVars['alarm_time']:
		'You wake up at <b><<func(''time'', ''get_time_string'',  hour,  minut, cheatVars[''time_format''])>></b>, just before your alarm goes off. You''ve had plenty of sleep.'
	elseif pcs_sleep >= 100:
		'You wake up at <b><<func(''time'', ''get_time_string'',  hour,  minut, cheatVars[''time_format''])>></b> no longer tired and ready to start the day with plenty of sleep.'
	elseif alarmVars['alarmOn'] = 1 and sleepVars['time_now'] = sleepVars['alarm_time']:
		pcs_mood -= 10
		'Your alarm goes off at <b><<func(''time'', ''get_time_string'',  hour, minut, cheatVars[''time_format''])>></b>, '+iif(pcs_sleep < 90, 'but you could do with some extra sleep.',  'and you''ve had plenty of sleep.')+''
		gs 'wakeup', 'snooze_alarm'
	else
		!! I do not think that it could go here
		''
	end

	if kanikuli = 0 and mid($start_type,1,2) = 'sg' and SchoolAtestat = 0 and SchoolBlock = 0 and week < 6 and hour >= 4 and hour < 9:
		act 'Get out of bed and get dressed for school (0:15)':
			minut += 15
			gs 'wardrobe', 'school_outfit'
			xgt 'bed_get_out', 'start'
		end
	end

	if strip_here = 1:
		act 'Get out of bed and get dressed (0:15)':
			minut += 15
			gs 'clothing', 'wear', $lastwornclothingtype['bed'], lastwornclothingnumber['bed']
			gs 'panties', 'wear', $lastwornpantytype['bed'], lastwornpantynumber['bed']
			gs 'bras', 'wear', $lastwornbratype['bed'], lastwornbranumber['bed']
			if $bed['shoetype'] ! 'none':
				gs 'shoes', 'wear', $bed['shoetype'], bed['shoenumber']
			end
			xgt 'bed_get_out', 'start'
		end
	end

	if cheatVars['full_morning_rout'] = 1 and hour >= 4 and hour < 12:
		act 'Full morning routine (1:00)':
			minut += 15
			fullmorrout = 1
			gs 'clothing', 'wear', $lastwornclothingtype['bed'], lastwornclothingnumber['bed']
			gs 'panties', 'wear', $lastwornpantytype['bed'], lastwornpantynumber['bed']
			gs 'bras', 'wear', $lastwornbratype['bed'], lastwornbranumber['bed']
			if $bed['shoetype'] ! 'none':
				gs 'shoes', 'wear', $bed['shoetype'], bed['shoenumber']
			end
			xgt 'bed_get_out', 'start'
		end
		if kanikuli = 0 and mid($start_type,1,2) = 'sg' and SchoolAtestat = 0 and SchoolBlock = 0 and week < 6 and hour >= 4 and hour < 9 and suspended['on'] ! 1:
			act 'Full morning routine for School (1:00)':
				fullmorrout = 1
				minut += 15
				gs 'wardrobe', 'school_outfit'
				xgt 'bed_get_out', 'start'
			end
		end
	end

	act 'Get out of bed (0:10)':
		minut += 10
		sleepVars['slept_in'] = 0
		xgt 'bed_get_out', 'start'
	end
end


if $ARGS[0] = 'snooze_alarm':
	act '"Snooze" a few minutes more...':
		menu_off = 1
		sleepVars['slept_in'] = 1
		gs 'stat'
		gt 'sleep', 'start'
	end
end

--- wakeup ---------------------------------
