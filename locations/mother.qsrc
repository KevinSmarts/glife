		else
			$texthcol2 = 'smiling. "It looks nice on you. I''m sure the boys will like it too. Just make sure you keep your grades up."'
		end
		'Your <<$npc_nickname[''A29'']>> immediately notices that you''ve dyed your hair. "Wait a minute, you dyed your hair! <<$texthcol>>"'
		'She runs her fingers through your hair before <<$texthcol2>>'

