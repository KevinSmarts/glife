	'After <<transportVars[''timecost'']>> minutes, the bus stops at the Pavlovsk train station bus station.'
	act 'Get off the bus':
		if rand(1, 100) <= 5: gt 'bus_incidental', 'end'
		gt $loc, $loc_arg
