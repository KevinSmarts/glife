		*nl
		*nl
		gs 'transport_functions', 'display_bus_schedule', 'gp'
		act 'Stop looking at the schedule': gt 'bus', 'pavstation_tickets'
	end

	gs 'transport_functions', 'buy_bus_ticket', 'pavstation', 'pg'

