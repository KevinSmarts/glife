# indiktab
! ARGS[1] ... percentage
!!  scales the bar from 0 to 100

! ARGS[2] ... real value
!!  the value displayed on the bar

! ARGS[3] ... phantom
!!  ghost value, used for painkillers


bar_progress = min(max(ARGS[1], 0), 100)
if ARGS[3] > 0: bar_phantom = min(max(ARGS[3] - bar_progress, 0), 100 - bar_progress)

if Enable_Android = 1:
	$bar_bg_color = 'gray'
else
	$bar_bg_color = $bcolor
end

if $ARGS[0] = '1':
	if Enable_Android = 1:
		if bar_progress  >= 65:
			$bar_color = 'green'
		elseif bar_progress >= 35:
			$bar_color = 'blue'
		else
			$bar_color = 'red'
		end
	else
		if bar_progress >= 85:
			$bar_color = '#008000'
			$phantom_color = '#003F00'
		elseif bar_progress >= 70:
			$bar_color = '#b3b300'
			$phantom_color = '#595900'
		elseif bar_progress >= 50:
			$bar_color = '#00CED1'
			$phantom_color = '#006666'
		elseif bar_progress >= 20:
			$bar_color = '#0000ff'
			$phantom_color = '#00007F'
		elseif bar_progress >= 10:
			$bar_color = '#ff6600'
			$phantom_color = '#7F3300'
		else
			$bar_color = '#ff0000'
			$phantom_color = '#7F0000'
		end
	end

elseif $ARGS[0] = '2':
	if Enable_Android = 1:
		if bar_progress  >= 85:
			$bar_color = 'red'
		elseif bar_progress >= 65:
			$bar_color = 'orange'
		elseif bar_progress >= 45:
			$bar_color = 'yellow'
		elseif bar_progress >= 25:
			$bar_color = 'green'
		else
			$bar_color = 'blue'
		end
	else
		if bar_progress >= 90:
			$bar_color = '#ff0000'
			$phantom_color = '#7F0000'
		elseif bar_progress >= 80:
			$bar_color = '#ff1a1a'
			$phantom_color = '#7F0E0E'
		elseif bar_progress >= 70:
			$bar_color = '#ff3333'
			$phantom_color = '#7F1919'
		elseif bar_progress >= 60:
			$bar_color = '#ff4d4d'
			$phantom_color = '#7F2727'
		elseif bar_progress >= 50:
			$bar_color = '#ff6666'
			$phantom_color = '#7F3333'
		elseif bar_progress >= 40:
			$bar_color = '#ff8080'
			$phantom_color = '#7F4141'
		elseif bar_progress >= 30:
			$bar_color = '#e68080'
			$phantom_color = '#724040'
		elseif bar_progress >= 20:
			$bar_color = '#cc8080'
			$phantom_color = '#664040'
		elseif bar_progress >= 10:
			$bar_color = '#b38080'
			$phantom_color = '#594040'
		else
			$bar_color = '#998080'
			$phantom_color = '#4C4040'
		end
	end
end

$result = '<TABLE  cellpadding="1" cellspacing="0" width="255"><TR>'
if bar_progress >= ARGS[3]:
	if bar_progress = 100: $bar_bg_color = $bar_color
	if bar_progress > 20:
		$result += '<TD bgcolor="<<$bar_color>>" width="<<bar_progress>>%" align="right"><font color ="<<$fcolor>>"><<ARGS[2]>></font>&nbsp;</TD>'
		$result += '<TD bgcolor="<<$bar_bg_color>>" width="<<100 - bar_progress>>%"></font></TD>'
	else
		$result += '<TD bgcolor="<<$bar_color>>" width="<<bar_progress>>%"></TD>'
		$result += '<TD bgcolor="<<$bar_bg_color>>" width="<<100 - bar_progress>>%" align="left">&nbsp;<font color ="<<$fcolor>>"><<ARGS[2]>></TD>'
	end
else
	if bar_progress + bar_phantom = 100: $bar_bg_color = $phantom_color
	if bar_progress > 20:
		$result += '<TD bgcolor="<<$bar_color>>" width="<<bar_progress>>%" align="right"><font color ="<<$fcolor>>"><<ARGS[2]>></font>&nbsp;</TD>'
		$result += '<TD bgcolor="<<$phantom_color>>" width="<<bar_phantom>>%"></font></TD>'
		$result += '<TD bgcolor="<<$bar_bg_color>>" width="<<100 - bar_phantom - bar_progress>>%"></font></TD>'
	else
		$result += '<TD bgcolor="<<$bar_color>>" width="<<bar_progress>>%"></TD>'
		$result += '<TD bgcolor="<<$phantom_color>>" width="<<bar_phantom>>%" align="left">&nbsp;<font color ="<<$fcolor>>"><<ARGS[2]>></TD>'
		$result += '<TD bgcolor="<<$bar_bg_color>>" width="<<100 - bar_phantom - bar_progress>>%"></TD>'
	end
end
$result += '</TR></TABLE>'

killvar 'bar_progress'
killvar 'bar_phantom'

killvar '$bar_color'
killvar '$phantom_color'
killvar '$bar_bg_color'

--- indiktab ---------------------------------
