# sister_chat
!!model Megan Vale Valentina Azarov
if $ARGS[0] = 'checks':
	menu_off = 1
	if npc_rel['A33'] < 20:
		'Your relationship with your sister is scandalous.'
	elseif npc_rel['A33'] >= 20 and npc_rel['A33'] < 40:
		'Your relationship with your sister is tense.'
	elseif npc_rel['A33'] >= 40 and npc_rel['A33'] < 60:
		'You and your sister have a normal relationship.'
	elseif npc_rel['A33'] >= 60 and npc_rel['A33'] < 80:
		'You and your sister have a good relationship.'
	elseif npc_rel['A33'] >= 80:
		'You have a great relationship with your sister.'
	end
	*nl

	!! If you are out of tampons:
	if npc_rel['A33'] > 65 and mesec > 0 and preg = 0 and mc_inventory['tampons'] =  0 and narkossister = 0:
		act 'Ask for a tampon':
			'You tell your sister that you''re menstruating and have no tampons. She looks at you knowingly, brings some of hers and recommends that you take care of this in advance next time.'
			mc_inventory['tampons'] =  3
			npc_rel['A33'] -= 15
			minut += 3
			gs 'stat'
			cla
			act 'Move away': gt $loc, $loc_arg
			exit
		end
	end

	!Responses that happen anywhere but in the kitchen
	if $loc ! 'kuhrPar':
		!! If you have visible cum on you:
		if cumloc[11] = 1 or (cumloc[6] = 1 or cumloc[7] = 1) and fame['pav_slut'] < 200:
			sisterknowslut = 1
			'Your sister looks at you. "What is that, <<$pcs_nickname>>?" Her eyes then narrow. "Is that cum!? What were you thinking walking around with that on you?! It''s a good thing I noticed and not Mom! God forbid what she would do if she ever saw you like that!"'
		elseif cumloc[11] = 1 or (cumloc[6] = 1 or cumloc[7] = 1) and fame['pav_slut'] >= 200 and sisterknowslut = 0:
			sisterknowslut = 1
			'Your sister looks at you. "<<$pcs_nickname>>?! So the rumors are true, you are <<$gnikname>>!"'
		elseif cumloc[11] = 1 or (cumloc[6] = 1 or cumloc[7] = 1) and fame['pav_slut'] >= 250 and sisterknowslut > 0:
			'Your sister looks at you. "Up to your usual tricks, <<$pcs_nickname>>? You could at least wash yourself."'
		end

		!! If you are on drugs:
		if drugVars['heroin_high'] = 0 and narkossister = 1: narkossister = 0

		if drugVars['heroin_high'] > 20 and narkossister = 0:
			if rand(1,100) >= 90:
				dynamic $narkosisterspalila
				exit
			end
		end

		if narkossister = 1:
			*clr & cla
			'<center><img <<$set_imgh>> src="images/pc/reactions/worry.jpg"></center>'
			if drugVars['heroin_high'] > 20:
				if pcs_mood > 10: pcs_mood -= 10
				gs 'stat'
				'You realize you''re way too high to talk to your sister right now and she would flip out if she noticed you''re high again, so you quickly move away before she notices.'
				act 'Move away': gt $loc, $loc_arg
			else
				if pcs_mood > 10: pcs_mood -= 1
				gs 'stat'
				narkossister = 0
				*nl
				'You steel yourself. '+$OpenInnerThought+'"Come on <<$pcs_nickname>>, deep breath, focus. You can do this."'+$CloseInnerThought
				'You feel your head is clear enough to talk to your sister once more.'
				act 'Chat': gt 'sister_chat', 'talking'
			end
		end

		!! If you are naked:
		if $clothingworntype = 'nude':
			if sisterLesb >= 7:
				'Anya looks at you, taking in your naked body with an amused expression on her face.'
				'"Are you trying to seduce me, <<$pcs_nickname>>?"'
			elseif sisterQW['naked'] = 0:
				sisterQW['naked'] = 1
				'Anya looks at you, her eyes wide. "What are you doing, <<$pcs_nickname>>?! What if someone walks in and sees you like this? Mom would throw a fit if she caught you walking around naked like that! I just don''t understand you sometimes..."'
			else
				'Anya shakes her head at you. "Mom is going to catch you sooner or later and tan your ass!"'
				act 'Move away': gt $loc, $loc_arg
				act 'Chat': gt 'sister_chat', 'talking'
			end
		end
	end

	!! Responses that only happen in the bedroom
	if $loc = 'bedrPar':
		!! If you haven''t learned how to braid hair yet:
		if canBraidHair = 0 and npc_rel['A33'] > 50 and pcs_hairlng > 80:
			act 'Can you teach me how to braid my hair?':
				*clr & cla
				minut += 1
				'She looks at you, eyebrow raised. "You don''t know how to braid your own hair?"'
				'You look down, embarrassed. "I usually just go to the salon for them to braid it..."'
				'She laughs and gives you a hug. "Of course I''ll teach you, though it might take a while."'
				act 'Learn how to braid your hair':
					minut += 60
					canBraidHair = 1
					npc_rel['A33'] += 5
					*clr & cla
					'<center><img <<$set_imgh>> src="images/characters/pavlovsk/resident/anya/braid.jpg"></center>'
					'You make plenty of mistakes and get your hair in a knot a couple of times, but you eventually feel confident enough to braid your hair on your own.'
					act 'Thank her and leave': gt $loc, $loc_arg
					act 'Chat': gt 'sister_chat', 'talking'
				end
				act 'Maybe another time':
					minut += 3
					gs 'stat'
					*clr & cla
					'"Thanks sis, but maybe some other time? I have somewhere to be right now."'
					'She shrugs. "Come back when you want to learn."'
					act 'Thank her and leave': gt $loc, $loc_arg
				end
			end
		end
	end

	!{ Chatting
	act 'Chat':
		*clr & cla
		minut+=rand(10,15)
		if sisterQW['chatday'] ! daystart: npc_rel['A33'] += 2
		sisterQW['chatday'] = daystart
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/resident/anya/sister2.jpg"></center>'
		if npc_rel['A33'] < 20:'Your relationship with your sister is awful.'
		if npc_rel['A33'] >= 20 and npc_rel['A33'] < 40:'Your relationship with your sister is tense.'
		if npc_rel['A33'] >= 40 and npc_rel['A33'] < 60:'You and your sister have a normal relationship.'
		if npc_rel['A33'] >= 60 and npc_rel['A33'] < 80:'You and your sister have a good relationship.'
		if npc_rel['A33'] >= 80:'You have a great relationship with your sister.'
		gt 'sister_chat', 'talking'
	end}
end

$narkosisterspalila = {
	menu_off = 1
	*clr & cla
	gs 'stat'
	!! 'sister slept on drugs.'
	'<center><img <<$set_imgh>> src="images/characters/pavlovsk/resident/anya/sister2.jpg"></center>'
	$OpenInnerThought+'"Come on <<$pcs_firstname>>, keep it together! Act sober,"'+$CloseInnerThought+' you think to yourself. '+$OpenInnerThought+'"I just have to talk normally and not think about it."'+$CloseInnerThought
	'Your sister looks at you, her eyebrow raised. "Are you stoned, <<$pcs_nickname>>?"'
	act 'No':
		cla
		narkossister = 1
		gs 'stat'
		'You nervously shake your head and back away, but it''s obvious that Anya can tell.'
		act 'Move away': gt $loc, $loc_arg
	end
	act 'Yes':
		*clr & cla
		narkossister = 1
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/resident/anya/sister2.jpg"></center>'
		'You admit that you learned where to buy drugs and wanted to try them out.'
		'Anya looks at you sternly. "<<$pcs_nickname>>, I''m not your mother, who would kill you if she found out by the way, but this is the first and last time. It''s not worth it! If you continue, then your whole life will not be worth shit."'
		act 'Move away': gt $loc, $loc_arg
		exit
	end
}

if $ARGS[0] = 'talking':
	*clr & cla
	menu_off = 1
	minut += 2
	gs 'stat'
!! sisterQW['party']
	!-1 - don''t go to the party
	!0 - don''t know about it
	!1 - agreed to go to the party
	!2 - been to the party
!! Regular party tracking: sisterQW['rexbday']
	!-1 - don''t go to the party
	!0 - don''t know about it
	!1 - agreed to go to the party
	!2 - been to the party
	!3 - party is over			(never seems to happen? - Sicaa)
