	minut += 1
	bonusZ = 0
	gs 'shortgs', 'setloc', 'radapt', $ARGS[0]
	$location_type = 'private'
	gs 'themes', 'indoors'
	gs 'stat'
	gs 'radomir_popov_schedule'
	if radomirQW['home_day'] ! daystart:
		radomirQW['home_day'] = daystart
