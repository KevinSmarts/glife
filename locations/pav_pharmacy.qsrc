	end
end

if $ARGS[0] = 'condom_addon':
	if money - cart_tally >= 300 or karta - cart_tally >= 300:
		act 'Might as well':
			LudaQW['condoms'] = 1
			LudaQW['knows_sex'] = 1
			if preziktype = 0:
				gs 'item_cart', 'simple_add', arrpos('$var_curr_aisle', 'equipped_condoms') + 1
			elseif preziktype = 1 or preziktype = 2:
				gs 'item_cart', 'simple_add', arrpos('$var_curr_aisle', 'normal_condoms') + 1
			end
			cla & *clr
			'<center><B><font color="maroon">Pharmacy</font></B></center>'
			'<center><img <<$set_imgh>> src="images/locations/pavlovsk/pharmacy/apteka_aunt_1.jpg"></center>'
			'"I might as well," you nod. "Just to be safe."'
			'"It always pays to be safe," Luda says, nodding once and adding a box of condoms to your purchase.'
			act 'Continue shopping': gt $loc_s, $args_s
		end
	end
	if LudaQW['knows_sex'] = 0 and $ludaQW['pharm_purchase'] = 'bc_pills':
		act 'It''s for my cycle':
			cla & *clr
			'<center><B><font color="maroon">Pharmacy</font></B></center>'
			'<center><img <<$set_imgh>> src="images/locations/pavlovsk/pharmacy/apteka_aunt_1.jpg"></center>'
			'"It''s just for my cycle Aunt Luda," you protest. She smiles at you with a suspicious twist at the corner of her mouth. "I''m not having sex."'
			'"Well, I can''t prove otherwise, so I suppose I''ll just have to take you at your word..."'
			act 'Continue shopping': gt $loc_s, $args_s
		end
	end
	$ludaQW['pharm_purchase'] = 'bc_pills'
end


if $ARGS[0] = 'birth_control_addon':
	act 'Finish your purchase': gt $loc_s, $args_s
	if $ludaQW['pharm_purchase'] ! 'condoms':
		act 'Prefer condoms':
			cla
			act 'Just preference':
				cla & *nl
				'"Thanks for the offer, but I''d rather stick to condoms."'
				'"If you say so..." Your aunt looks back at you with skepticism. "But even your mother is on the pill now."'
				act 'Continue shopping': gt $loc_s, $args_s
			end

			act 'Safer':
				cla & *nl
				'"Thanks for the offer, but I''d rather stick to condoms. It''s easy to forget a pill. Not quite as easy to forget to put on a condom."'
				'"Easier than you think," Your aunt looks back at you with skepticism. "Good protection is about layers though. You should really be using both..."'
				act 'Continue shopping': gt $loc_s, $args_s
			end

			act 'Cheaper':
				cla & *nl
				'"Thanks for the offer, but I''d rather stick to condoms. They''re cheaper."'
				'"Depends how often you use them," your aunt says with a wry smirk. "The pill might be less expensive in the long run..."'
				act 'Continue shopping': gt $loc_s, $args_s
			end

			act 'No hormones':
				cla & *nl
				'"Thanks for the offer, but I''d rather stick to condoms. I don''t want to mess with my hormones like that."'
				'"I suppose I understand that reason better than some," your aunt sighs ruefully. "But even your mother is on the pill now."'
				act 'Continue shopping': gt $loc_s, $args_s
			end
		end
	elseif $ludaQW['pharm_purchase'] ! 'bc_pills':
		if money - cart_tally < 1870 and karta - cart_tally < 1870:
			act 'I don''t have the money':
				cla & *nl
				'"I don''t have the money," you shrug, smiling wistfully.'
				'"Well at least you''re being safe in the mean time," she says, handing them over.'
				'"Thanks, Aunt Luda."'
				'"Any time, darling!"'
				act 'Continue shopping': gt $loc_s, $args_s
			end

			act 'Can only afford condoms':
				cla & *nl
				'"I don''t have the money," you shrug, smiling wistfully. "Condoms are cheap and they''re all I can afford right now."'
				'"Well at least you''re being safe in the mean time," she says, handing them over.'
				'"Thanks, Aunt Luda."'
				'"Any time, darling!"'
				act 'Continue shopping': gt $loc_s, $args_s
			end

		else
			act 'Not a bad idea (buy birth control)':
				cla & *nl
				pharmacyfirstbirthcontrol = 1
				gs 'item_cart', 'simple_add', arrpos('$var_curr_aisle', 'contraceptive_pill') + 1
				'"That''s... not a bad idea. I guess I could while I''m here."'
				'"Good choice," Luda says, nodding once and adding on pills to your purchase. "It pays to be safe."'
				act 'Continue shopping': gt $loc_s, $args_s
			end

			act 'Might as well be safe (buy birth control)':
				cla & *nl
				pharmacyfirstbirthcontrol = 1
				gs 'item_cart', 'simple_add', arrpos('$var_curr_aisle', 'contraceptive_pill') + 1
				'"I guess I might as well. Just to be safe."'
				'"It always pays to be safe," Luda says, nodding once and adding on pills to your purchase.'
				act 'Continue shopping': gt $loc_s, $args_s
			end
		end
	end
	$ludaQW['pharm_purchase'] = ''
end
