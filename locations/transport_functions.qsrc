	elseif $ARGS[1] =  'construction':
		result = 25
	elseif $ARGS[1] = 'gadukino':
		result = 50
	elseif $ARGS[1] = 'communal':
		result = 70
	elseif $ARGS[1] = 'graveyard':
		result = 80
	elseif $ARGS[1] = 'suburbs':
		result = 90
	end
end




