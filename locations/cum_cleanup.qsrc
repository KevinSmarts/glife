			end
		else
			if sparrvol[n] <= 0 and ($sparrnam[n] = '' or sparrloc[n] ! 0 or (sparrloc[n] = 0 and sparrage[n] > 10)): gs 'cum_cleanup', 'cleandeposit', n
			n += 1
		end
		jump 'cumcleanloop'
	end
	killvar 'toclean'
	killvar 'deresidue'
	killvar 'tmp'
	killvar 'n'
	killvar 'lubonus'
	killvar 'anal_slip'
	killvar 'vaginal_slip'
	killvar 'ar_anal_lube'
	killvar 'ar_vag_lube'
