			gs 'pav_station', 'first_prostitution'
		elseif temp_tot_booked_pav < 6:
			gt 'pav_station', 'repeat'
		elseif temp_tot_booked_pav < 11:
			gt 'pav_station', 'repeat'
		else
			gt 'pav_station', 'regular'
		end
	end
end

