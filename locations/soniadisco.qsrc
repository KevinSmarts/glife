if $ARGS[0] = 'join_them':
	*clr & cla
	grupvalue[1] -= 1
	grupvalue[2] -= 1
	grupvalue[4] += 1
	gs 'npc_relationship', 'modify', 'A9', 'like'
	gs 'npc_relationship', 'modify', 'A10', 'like'
	gs 'npc_relationship', 'modify', 'A11', 'like'
	gs 'npc_relationship', 'modify', 'A24', 'like'
	'<center><img <<$set_imgh>> src="images/locations/pavlovsk/community/disco/gopdrinking.jpg"></center>'
	'You''re not sure whether he invited you along because he wants you to come, or just because he''s afraid you would rat them out. Either way, you follow the guys outside to a small table around the back of the community center. Vasily pours the booze, vodka, into some plastic cups and hands everybody one, including you. Vitek, Sonia, Dan, Vasily and Pauline are here along with you.'
	if soniarushout = 1:
		killvar 'soniarushout'
		'You join them outside at the small table they''ve been using behind the community center. Finding yourself next to Sonia, you turn to her and whisper, "I am surprised you came back to party with them after last time."'
		'She blushes a little. "I won''t get that drunk again."'
	end
	gs 'willpower', 'drink', 'resist'
	if will_cost <= pcs_willpwr:
		act 'Decline drink (<<will_cost>> Willpower)':
			gs 'willpower', 'pay', 'resist'
			minut += 10
			grupvalue[4] -= 1
			gs 'npc_relationship', 'modify', 'A9', 'dislike'
			gs 'npc_relationship', 'modify', 'A10', 'dislike'
			gs 'npc_relationship', 'modify', 'A11', 'dislike'
			gs 'npc_relationship', 'modify', 'A24', 'dislike'
			gs 'stat'
			$soniadisco_peerpressuretrigger = 'declinedrink'
			gs 'soniadisco', 'peerpressure'
		end
	else
		act 'Decline (<font color="red"><<will_cost>> Willpower</font>)': '<br><font color="red">You don''t have enough willpower to use this action.</font>'
	end
	act 'Have a drink with them':
		*clr & cla
		gs 'drugs', 'alcohol', 'vodka', 1
		minut += 15
		grupvalue[4] += 1
		gs 'npc_relationship', 'modify', 'A9', 'like'
		gs 'npc_relationship', 'modify', 'A10', 'like'
		gs 'npc_relationship', 'modify', 'A11', 'like'
		gs 'npc_relationship', 'modify', 'A24', 'like'
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/locations/pavlovsk/community/disco/gopdrinking.jpg"></center>'
		'For the next 15 minutes, you enjoy their company, only slowly sipping the vodka and alternating it with lemonade. Sonia just slams down shot after shot. When the cups are empty, Vasily offers everyone a refill.'
		gs 'willpower', 'drink', 'resist'
		if will_cost <= pcs_willpwr:
			act 'Decline (<<will_cost>> Willpower)':
				gs 'willpower', 'pay', 'resist'
				minut += 10
				grupvalue[4] -= 1
				gs 'npc_relationship', 'modify', 'A9', 'dislike'
				gs 'npc_relationship', 'modify', 'A10', 'dislike'
				gs 'npc_relationship', 'modify', 'A11', 'dislike'
				gs 'npc_relationship', 'modify', 'A24', 'dislike'
				gs 'stat'
				$soniadisco_peerpressuretrigger = 'declinedrink'
				gs 'soniadisco', 'peerpressure'
			end
		else
			act 'Decline (<font color="red"><<will_cost>> Willpower</font>)': '<br><font color="red">You don''t have enough willpower to use this action.</font>'
		end
		act 'Take another drink':
			minut += 10
			gs 'drugs', 'alcohol', 'vodka', 1
			grupvalue[4] += 1
			gs 'stat'
			$soniadisco_peerpressuretrigger = 'takedrink'
			gs 'soniadisco', 'peerpressure'
		end
		act 'Caution Sonia':
			soniaQW['help'] += 1
			minut += 10
			grupvalue[4] -= 5
			gs 'npc_relationship', 'modify', 'A9', 'loathe'
			gs 'npc_relationship', 'modify', 'A10', 'loathe'
			gs 'npc_relationship', 'modify', 'A11', 'loathe'
			gs 'npc_relationship', 'modify', 'A24', 'loathe'
			gs 'npc_relationship', 'modify', 'A25', 'dislike'
			gs 'stat'
			$soniadisco_peerpressuretrigger = 'cautionsonia'
			gs 'soniadisco', 'peerpressure'
		end
		if soniaQW['soniafall'] <= 6:act 'Encourage her': gt 'soniadisco', 'soniadrinkmore'
	end
end

