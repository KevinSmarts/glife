# soniadisco
!2021/22/12
!!I changed Sonia fall to this so their is a total of 7 events so Sonia slowly falls. moved the automatic fall code here from cikl.

if $ARGS[0] = 'cikl':
!!Making Sonia''s fall progress if the player do not see the scenes at the disco, by making it such that if at a Sunday her fall have not advanced this weekend it will automatically advance.
	if mid($start_type,1,2) = 'sg' and week = 7 and soniaQW['slut'] = 0 and month > 9 and daystart >= soniaQW['fallday'] + 6:
		if soniaQW['soniafall'] < 7:
			soniaQW['fallday'] = daystart -1
			soniaQW['soniafall'] += 1
		else
			soniaQW['slut'] = 1
			soniaQW['slutdays'] = daystart
			npc_grupTipe['A25'] = 5
			$npc_notes['A25'] = 'Ever since Sonia got way too drunk and gave Vitek and his friends blowjobs outside the disco, her reputation in Pavlovsk has been in shambles. The girls in her class all give her the silent treatment, while the guys treat her like a cheap whore and regularly ask (or sometimes demand) sex from her, knowing she doesn''t have the strength to say no.'
			$npcGoSchool['A25'] = '<a href="exec:gt ''gschool_outcast_chats'', ''' + $lcase($npc_usedname['A25']) + '''"><<$npc_usedname["A25"]>></a>'
		end
	end
end

!!Which arg it goes to depends on level of soniaQW['soniafall']
if $ARGS[0] = 'start':
	if daystart >= soniaQW['fallday'] + 6:
		soniaQW['fallday'] = daystart
		if soniaQW['soniafall'] <= 0:
			gt 'soniadisco', 'disco0'
		else
			gt 'soniadisco', 'disco'
		end
	else
		gt 'soniadisco', 'disco0'
	end
end

if $ARGS[0] = 'disco0':
	menu_off = 0
	*clr & cla
	if soniaQW['soniafall'] = 0: soniaQW['soniafall'] = 1
	minut += 15
	gs 'stat'
	'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/girl/sonia/0.jpg"></center>'
	'You notice Sonia out on the dance floor really working her body. She seems to be dancing like there is no tomorrow. As you watch, she stops from time to time to go grab some drinks from the gopniks, who seem happy to supply her with alcohol.'
	act 'Keep watching':
		*clr & cla
		minut += 15
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/girl/sonia/disco/soniadance.jpg"></center>'
		'You''ve heard the rumors that Sonia had begun hanging around the gopniks lately; drinking, partying and generally cutting loose. But watching her now, you can see that she is getting totally wasted and is starting to really grind on any and everyone that comes up to dance with her. After a while, she seems to barely be able to stand up on her own and is hanging onto the guys she''s grinding into to keep her balance.'
		if soniaQW['soniafall'] < 3:
			gs 'soniadisco', 'watchorhelp'
		else
			gs 'soniadisco', 'soniashowsboobs'
		end
	end
end

if $ARGS[0] = 'watchorhelp':
	if hour > 19: discobloc['A25'] = daystart
	act 'Just watch':
		*clr & cla
		minut += 20
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/girl/sonia/disco/soniadance.jpg"></center>'
		'The boys are getting quite frisky with Sonia, who is hardly putting up any resistance. Their hands roam all over her while she just stumbles around, too drunk to care what''s happening.'
		'Several minutes later, Katja walks up to Sonia and tries to get her to leave the dance floor, but the girl jerks away and says something that leaves Katja just shaking her head before walking away.'
		'Eventually, Sonia stumbles over to the girls'' restroom, looking a bit sick, and you notice Katja follow her. After a while, the two walk out and leave the disco, presumably Katja is taking Sonia home.'
		act 'Continue': gt 'pav_disco'
	end
	act 'Help Sonia':
		*clr & cla
		minut += 2
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/girl/sonia/disco/soniadance.jpg"></center>'
		'The boys are getting quite frisky with Sonia, who is hardly putting up any resistance. Their hands roam all over her while she just stumbles around, too drunk to care what''s happening.'
		'You shake your head in disbelief; Sonia is too drunk to realize what''s happening! If she isn''t careful, some guy is going to drag her away and take advantage of her.'
		'You walk over to the girl, "Slow down, Sonia! You''re pretty wasted and giving the guys the wrong idea."'
		'She turns and gives you a sour look, "What are you, my mother? God, I''m tired of having to always be the good girl; I just want to cut loose and party for once!" With that, she starts grinding her butt on some guy''s crotch, who looks more than happy to oblige.'
		act 'Walk away':
			*clr & cla
			minut += 20
			gs 'stat'
			'<center><img <<$set_imgh>> src="images/characters/pavlovsk/school/girl/sonia/disco/soniadance.jpg"></center>'
			'You just shake your head and leave Sonia, who continues dancing around and grinding on boys. And there are no shortage of boys trying to dance with her. She looks like she''s having fun, but you can see others watching and whispering about her acting like a slut.'
			'Several minutes later, Katja walks up to Sonia and tries to get her to leave the dance floor, but the girl jerks away and says something that leaves Katja just shaking her head before walking away.'
			'Eventually, Sonia stumbles over to the girls'' restroom, looking a bit sick, and you notice Katja follow her. After a while, the two walk out and leave the disco, presumably Katja is taking Sonia home.'
			act 'Continue': gt 'pav_disco'
		end
		act 'Convince her':
			*clr & cla
			minut += 20
			grupvalue[4] -= 2
			grupvalue[1] += 2
			gs 'npc_relationship', 'modify', 'A25', 'like'
			gs 'stat'
			'<center><img <<$set_imgh>> src="images/characters/shared/headshots_main/big25.jpg"></center>'
			'You stand in front of her and grab hold of her arms to keep her still. "Sonia! Look around, you''re totally wasted and grinding on these guys like you plan to fuck them all."'
			'She resists for a moment, but then your words seem to sink in and she drunkenly blinks a few times before looking around. She blushes a bit and seems to sober up some, the realization of just how wasted she was hitting her. She gives you a grateful nod and awkwardly tries to leave the dance floor, but the guys try to keep her around. You have to intervene on her behalf and make them let go of her. The two of you finally make it to the door and leave the dance hall.'
			*nl
			'She smiles at you a bit. "Thanks, <<$pcs_nickname>>. I guess I got a little carried away."'
			'"Maybe you should go home, you''re pretty drunk," you reply.'
			'She nods. "Thanks, yeah." She starts to head out, and you notice she can barely walk, but when you start to help her, she pulls away. "I can handle it myself."'
			'You sigh a bit. "Just be careful."'
			'She rolls her eyes. "It was just a little harmless fun, no one cares." Then she walks away.'
			act 'Continue': gt 'pav_disco'
		end
	end
end

