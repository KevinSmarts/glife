			elseif temp_bc_rand = 2:
				npc_start_free_time[$ARGS[1]] = 16
				npc_end_free_time[$ARGS[1]] = 20
			else
				npc_start_free_time[$ARGS[1]] = 20
				npc_end_free_time[$ARGS[1]] = 23
			end
