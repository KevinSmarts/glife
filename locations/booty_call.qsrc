			if rand(1,2) = 1:
				npc_start_free_time[$ARGS[1]] = 9
				npc_end_free_time[$ARGS[1]] = 12
			else
				npc_start_free_time[$ARGS[1]] = 20
				npc_end_free_time[$ARGS[1]] = 23
			end
		elseif npc_finance[$ARGS[1]] = 2:
