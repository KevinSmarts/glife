# lover_change

gs 'npcStat', $lover[lover_number]
dynamic $npc_preferences[$npcID]


if $ARGS[0] = 'Hair':
	menu_off = 1
	gs 'stat'

	'As you arrive at the salon with <<$npcdesc>>, <<$Xe>> heads over to the counter and tells something to the barber. The barber nods and comes towards you.'
	'"So Ms. <<$pcs_lastname>>, you want to get your hair dyed <<$hairPref>> now is that right?"'
	act 'Nod':
		cla
		'Knowing there is no way to back out of this now, you meekly nod.'
		'"Alrighty then, your hair will be <<$hairPref>> before you know it!"'
		act 'Take a seat':
			cla
			pcs_haircol = temp_haircol & killvar 'temp_haircol'
			dyefade = rand(35,42)
			collength = pcs_hairlng
			minut += 20
			gs 'stat'

			'In less then half an hour you see that your hair''s original color has been changed to <<$hairPref>>.'
			act 'Get up from chair and go to your <<$npcrelat>>.':
				cla
				'You walk towards your <<$npcrelat>> with your new <<$hairPref>> hair and <<$Xe>> tells you that you look amazing.'
				'You can''t say why, but you feel it would be harder to say no next time if <<$Xe>> asked you to change something.'
				'You then leave the salon and head home.'

				killvar '$hairPref'
				npc_compliance[$npcID] -= 1

				act 'Continue': gt 'homes_properties', 'go_home'
			end

		end
	end
	exit
end

if $ARGS[0] = 'Make':
	menu_off = 1
	minut += 60
	gs 'stat'

	if npc_pref_values['cosmetics_makeup_light'] > 0:
		makeupSetting = 2
	elseif npc_pref_values['cosmetics_makeup_moderate'] > 0:
		makeupSetting = 3
	else
		makeupSetting = 4
	end

	'After you agree to change your makeup routine for <<$Xem>>, you talk a bit with <<$Xem>> for an hour and then head home.'
	'You can''t say why, but you feel it would be harder to say no next time if he asked you to change something.'

	npc_compliance[$npcID] -= 1

	act 'Continue': gt 'homes_properties', 'go_home'
	exit
end

if $ARGS[0] = 'Pier':
	menu_off = 1
	gs 'stat'

	'Since you agreed to adjust your piercings to fit your <<$npcrelat>>''s preferences, <<$Xe>> looks at any pre-existing piercings you may have.'

	if pcs_piercings['wearing'] >= pierPrefTmpMin and pcs_piercings['wearing'] < pierPrefTmpMax:
		'This should not fire off. NO else if.'
		act 'Continue': gt 'homes_properties', 'go_home'
		exit

	elseif pcs_piercings['wearing'] > pierPrefTmpMax:
		'<<$npcdesc>> says that you just need to remove the ones that you have and you will look amazing.'
		act 'Let <<$Xem>> remove some piercings.':
			cla
			if pcs_piercings['navel'] > 0 and pcs_piercings['wearing'] < pierPrefTmpMin:
				'<<$Xec>> takes the barbell out of your navel.'
				pcs_horny += 2
				gs 'piercing_management', 'remove', 'navel'
			end
			if pcs_piercings['brow'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$npcdesc>> <<$Xec>> sees the piercing in your eyebrow and proceeds to remove it.'
				gs 'piercing_management', 'remove', 'brow'
			end
			if pcs_piercings['lip'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$Xec>> carefully takes the ring out of your lips.'
				gs 'piercing_management', 'remove', 'lip'

			end
			if pcs_piercings['nipples'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$npcdesc>> looks around, then carefully uses <<$Xyr>> hands to take the nipple rings off your breasts.'
				pcs_horny += 5
				gs 'piercing_management', 'remove', 'nipples'
			end
			if pcs_piercings['nose'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$Xec>> sees the nose ring that you are wearing and removes it.'
				gs 'piercing_management', 'remove', 'nose'
			end
			if pcs_piercings['pussy'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$npcdesc>> gets close to your ear, "Don''t make a scene okay?", then he non chalontely slides <<$Xyr>> hand down to your labia, and removes the ring there.'
				'You cover your mouth as you let out a quick "Eep!", but in a second, it''s over.'
				pcs_horny += 7
				gs 'piercing_management', 'remove', 'pussy'
			end
			if pcs_piercings['tongue'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$Xec>> asks you to stick out your tongue, then removes the barbell in your tongue.'
				gs 'piercing_management', 'remove', 'tongue'
			end
			if pcs_piercings['ears'] > 0 and pcs_piercings['wearing'] > pierPrefTmpMax:
				'<<$Xec>> sees your earrings and quickly takes them off.'
				gs 'piercing_management', 'remove', 'ears'
			end
			act '"All done!" <<$npcdesc>> says.':
				cla
				minut += 60
				gs'stat'
				'<<$npcdesc>> says "All done!" and promptly hands you the piercings <<$Xe>> took off.'
				'After this you guys talk for an hour about various things, before <<$Xe>> gets up and says <<$Xe>> has to go.'
				'You can''t say why, but you feel it would be harder to say no next time if <<$Xe>> asked you to change something.'
				npc_compliance[$npcID] -= 1
				act 'Continue': gt 'homes_properties', 'go_home'
				exit
			end
		end
	else
		if pcs_piercings['total'] >= pierPrefTmpMin:
			'<<$npcdesc>> sees that you have enough piercings already, and that you just need to wear them.'
			act 'Let <<$Xem>> add piercings':
				cla
				'<<$Xec>> pulls out a couple of piercings and starts to put them on you.'
				if pcs_piercings['tongue'] < 0 and pcs_piercings['wearing'] < pierPrefTmpMin:
					'<<$Xec>> asks you to stick out your tongue, then inserts a barbell into your tongue.'
					gs 'piercing_management', 'wear', 'tongue', 1
				end
				if pcs_piercings['lip'] < 0 and pcs_piercings['wearing'] < pierPrefTmpMin:
					'<<$Xec>> gently holds your lip, then inserts a ring.'
					gs 'piercing_management', 'wear', 'lip', 1
				end
				if pcs_piercings['ears'] < 0 and pcs_piercings['wearing'] < pierPrefTmpMin:
					'<<$Xec>> sees you do not have earrings and proceeds to put rings onto your ears. '
