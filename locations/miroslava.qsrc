# miroslava
!2021/05/05
!2024/05/05 - Mira schedule introduced.
!locat['A60'] = Mira''s location. See 'miroslava_schedule'
!!Model used - Pyanzina Svetlana Petrovna

if $ARGS[0] = 'start' or $ARGS[0] = '':
	gs 'shortgs', 'setloc', 'miroslava', 'start'
	menu_off = 0

	gs 'boyStat', 'A60'
	girlage = age

	!locat['A60'] = Mira''s location. See 'miroslava_schedule'

	!---------------------------------------------
	! MiraVars['QW'] = 1 Mira met local guys
	! MiraVars['QW'] = 2 Mira admits that she likes Mitka
	! MiraVars['QW'] = 3 PC watches Mitka and Mira sex
	! MiraVars['QW'] = 4 Mira has to fullfill 3 wishes .. PC is Dom
	! MiraVars['QW'] = 5 Mira has to fullfill 3 wishes .. PC is Sub or Neutral
	! MiraVars['QW'] = 5 PC wants to watch M and M anal sex
	! MiraVars['QW'] = 6 PC watches M and M anal sex
	! MiraVars['QW'] = 7 First wish fulfilled
	! MiraVars['QW'] = 8 Second wish - mira has to pose as prostitute
	! MiraVars['QW'] = 9 Mira pissed at party
	! MiraVars['QW'] = 10 Mira pissed at party
	! MiraVars['QW'] = 11 Guys fuck Mira after she pissed at party
	! MiraVars['QW'] = 12 PC tells her about it
	! MiraVars['QW'] += Mira pose as a prostitute

	! daystart < MiraVars['emb_day'] hiding in her house after 3rd wish. Reduces 1 per day, plus 1 more per day if you talk to her

	gs 'miroslava', 'miraclothes'
	'Mira is a sociable girl. She is <<girlage>> years old. She lives with her father, who recently moved in here because of his considerable debts to some disreputable men in the city. He had to sell all the family''s property, including an apartment in the city center. With the money left over, they could only afford to buy a house in a rundown village like this one.'

	!npc_rel['A60'] is the measure of your friendship with Mira
	if npc_rel['A60'] < 25:
		'You two have a strained relationship.'
	elseif npc_rel['A60'] < 45:
		'You two have a normal relationship.'
	elseif npc_rel['A60'] < 65:
		'You have a good relationship with Mira.'
	elseif npc_rel['A60'] < 80:
		'You two have a great relationship.'
	else
		'You and Mira are best friends.'
	end

	if grandpaQW['chore_herd_cattle'] = 1:
		gs 'miroslava', 'cattle_chore_acts'
	end

	if MiraVars['QW'] = 11:
		act 'Talk to Mira in the meadow': gt 'gad_meadow', 'miraperversion11'
	elseif MiraVars['QW'] >= 15 and MiraVars['had_sex'] = 0 and locat['A60'] = 61 and npc_QW['A63'] < 13 and pcs_horny >= 40:
		act 'Talk to Mira in the meadow': gt 'gad_meadow', 'lesb_talk_mira1'
	elseif MiraVars['QW'] >= 15 and npc_QW['A63'] >= 13 and MiraVars['had_sex'] = 1 and MiraVars['cuni_given'] = 0 and locat['A60'] = 61 and pcs_horny >= 60:
		act 'Talk to Mira in the meadow': gt 'gad_meadow', 'lesb_talk_mira2'
	else
		if $loc = 'gad_meadow' and locat['A60'] = 61 and pcs_horny >= 40:
			if MiraVars['had_sex'] = 1 and npc_QW['A63'] < 13 and MiraVars['cuni_given'] > 0: act 'Talk to Mira in the meadow': gt 'gad_meadow', 'lesb_talk_mira3'
			if MiraVars['had_sex'] = 2 and npc_rel['A60'] >= 15: act 'Talk to Mira in the meadow': gt 'gad_meadow', 'lesb_mira'
		end

		act 'Leave': gt 'miroslava', 'leave'
		act 'Chat': gt 'miroslava', 'miratalk'

		if month >= 4 and month <= 10 and sunWeather = 1:
			act 'Offer to walk together': gt 'miroslava', 'walk_together'
		end

		if gad_meadow_found = 1 and MiraVars['meadow'] = 0 and (locat['A60'] / 10) ! 6:
			act 'Show her your secret place':
				menu_off = 1
				*clr & cla
				minut += 30
				npc_rel['A60'] += 2
				MiraVars['meadow'] = 1

				MiraVars['follower'] = 1
				MiraVars['follow_time'] = 1
				MiraVars['guest'] = 0

				if ($clothingworntype = 'nude' or PCloswimwear = 1):
					gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber
					gs 'underwear', 'wear'
				end
				gs 'stat'

				'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/girls_go.jpg"></center>'
				'You lead Mira through the thickets to the hidden meadow and all the way she talks about everything and anything, merrily telling stories from her past urban life.'

				act 'Continue':
					gs 'miroslava', 'exit'
					gt 'gad_meadow', 'start'
				end
			end
		end

		if (MiraVars['meadow'] = 2 or MiraVars['meadow'] = 5) and hour >= 8 and hour < 19 and (locat['A60'] / 10) ! 6 and sunWeather = 1:
			act 'Offer to go to the Meadow': gt 'miroslava', 'offer_go_meadow'
		end

		if npc_rel['A60'] >= 15 and hour >= 20 and MiraVars['QW'] = 0 and locat['A60'] ! 60:
			act 'Ask if she''s met the local boys?':
				menu_off = 1
				*clr & cla
				minut += 2
				npc_rel['A60'] += 1
				if ($clothingworntype = 'nude' or PCloswimwear = 1):
					gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber
					gs 'underwear', 'wear'
				end
				gs 'stat'
				gs 'miroslava', 'miraclothes'
				'You ask Mira if she has already met everyone in the village. When she says no, you offer to introduce her to some local guys, and she readily agrees, asking you to wait a few minutes while she changes and freshens up. When she comes out, you go drinking with the group of boys near your house...'

				MiraVars['follower'] = 1
				MiraVars['follow_time'] = 24 - hour
				act 'Continue':
					minut += 15
					gs 'miroslava', 'exit'
					gt 'mitkabuh'
				end
			end
		end

		if npc_rel['A60'] >= 16 and hour >= 20 and MiraVars['QW'] > 0 and sunWeather = 1 and locat['A60'] ! 60:
			act 'Drink with the local guys': gt 'miroslava', 'offer_drink_boys'
		end

		if npc_rel['A60'] >= 20 and week >= 6 and hour > 18 and hour < 22:
			act 'Invite for a steam bath': gt 'miroslava', 'offer_steam_bath'
		end

		if sunWeather = 1 and temper >= 15 and month >= 5 and month <= 9 and locat['A60'] ! 51:
			act 'Offer to go to the river': gt 'miroslava', 'offer_go_river'
		end

		if sunWeather = 1 and temper >= 15 and month >= 5 and month <= 9 and locat['A60'] ! 60 and MiraVars['pickingtalk'] > 0 and npc_rel['A60'] >= 5:
			act 'Offer to go to the forest': gt 'miroslava', 'offer_go_forest'
		end

		if sunWeather = 1 and temper >= 15 and month >= 5 and month <= 9 and locat['A60'] = 60 and MiraVars['nudetalk'] > 1 and npc_rel['A60'] >= 5 and $clothingworntype ! 'nude' and forestpicnic = 0:
			if pcs_inhib >= 25 or exhibitionist_lvl > 1:
				act 'Offer to walk naked':
					menu_off = 1
					*clr & cla
					minut+=5
					gs 'clothing', 'strip_all', 'forest_edge'
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/miraforest6.jpg"></center>'
					'You offered Mira to walk through the woods naked, and she immediately agreed.'

					act'Continue': gt 'gad_forest', 'forest_edge'
				end
			end
		end

		if npc_rel['A60'] >= 15 and locat['A60'] ! 60 and grandmaQW['block'] = 0 and (npc_QW['A63'] < 11 or MiraVars['QW'] >= 11 or MiraVars['had_sex'] > 1) and $start_type['loc'] = 'sg':
			gs 'miroslava', 'guest_acts'
		end


		if locat['A60'] ! locat['A60_prev'] and MiraVars['meadow'] > 1:
			*clr & cla
			menu_off = 1
			minut += 5
			gs 'stat'

			if locat['A60_prev'] = 10:
				gs 'miroslava', 'miraclothes'
				'"<<$pcs_nickname>>, you''re fun to be with, but my dad has chores for me to work on," Mira tells you.'
			else
				if locat['A60_prev'] = 51:
					if $clothingworntype ! 'nude':'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_go_home.jpg"></center>'
					if $clothingworntype = 'nude':'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_go_home_nude.jpg"></center>'
				else
					gs 'miroslava', 'miraclothes'
				end
				'"<<$pcs_nickname>>, you''re fun to be with, but I gotta get home. My dad has chores for me to work on." Mira tells you.'
			end

			if $clothingworntype = 'nude':
				gs 'clothing', 'wear_last_worn'
				gs 'underwear', 'wear'
			end

			act 'Go back to the village':
				gs 'miroslava', 'exit'
				gt 'Gadukino'
			end
		end

		if npc_rel['A60'] >= 15 and daystart >= MiraVars['emb_day'] and (npc_QW['A63'] < 11 or MiraVars['QW'] >= 11 or MiraVars['had_sex'] > 1):
			temp_rand = rand(0, 20)
			if (temp_rand = 1 or temp_rand = 2) and MiraVars['guest'] = 0 and MiraVars['follow_time'] = 0 and locat['A60'] ! 60 and grandmaQW['block'] = 0 and $start_type['loc'] = 'sg':
				*clr & cla
				menu_off = 1
				minut += 1
				gs 'stat'

				if locat['A60'] = 51:
					gs 'miroslava', 'mira_river'
				else
					gs 'miroslava', 'miraclothes'
				end
				'"<<$pcs_nickname>>, it''s so boring here," Mira pouts, "I know! Let''s go to your place." Mira suggests brightly.'

				act 'Agree':
					*clr & cla
					MiraVars['follow_time'] = 1
					MiraVars['guest'] = 1
					if ($clothingworntype ! 'nude' and PCloswimwear = 0):
						minut += 15
						npc_rel['A60'] += 1
						gt 'gad_gphouse', 'entry'
					else
						npc_rel['A60'] += 1
						if npc_rel['A60'] < 30: npc_rel['A60'] += 1
						minut += 20
						gs 'underwear', 'wear'
						gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber

						'<center><img <<$set_imgh>> src="images/locations/gadukino/river/dressbch.jpg"></center>'
						'You change into your clothes and go home with Mira.'

						act 'Continue': gt 'gad_gphouse', 'entry'
					end
				end

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1
					gs 'stat'

					'<center><img <<$set_imgh>> src="images/pc/reactions/speak_to_the_hand.jpg"></center>'
					'You deny Mira, saying that you don''t want to right now.'

					act 'Continue': gt 'miroslava', 'start'
				end

			elseif (temp_rand = 3 or temp_rand = 4) and MiraVars['guest'] = 1:
				menu_off = 1
				*clr & cla
				minut += 1
				gs 'stat'
				gs 'miroslava', 'miraclothes'

				'"<<$pcs_nickname>>, come watch TV with me. That''s boring -"  Mira said.'

				act 'Agree':
					*clr & cla
					minut += 60
					if npc_rel['A60'] < 20: npc_rel['A60'] += 1
					pcs_mood += 10
					gs 'stat'

					'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_tv'+rand(1,12)+'.jpg"></center>'
					'You watch TV with Mira for an hour.'

					act 'Continue': gt 'gad_gphouse', 'entry'
				end

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1

					'<center><img <<$set_imgh>> src="images/pc/reactions/speak_to_the_hand.jpg"></center>'
					'You deny Mira, saying that you don''t want to right now.'

					act 'Continue': gt $loc, $loc_arg
				end

			elseif temp_rand = 5 and locat['A60'] ! 61 and locat['A60'] ! 60 and (MiraVars['meadow'] = 2 or MiraVars['meadow'] = 5) and MiraVars['follow_time'] = 0 and hour < 19 and sunWeather = 1:
				menu_off = 1
				*clr & cla
				minut += 1
				gs 'stat'
				gs 'miroslava', 'miraclothes'
				'"<<$pcs_nickname>>, can we go to the meadow?" Mira asked you. "Let''s take a walk and get some fresh air."'

				act 'Agree':
					*clr & cla
					minut += 15
					if npc_rel['A60'] < 50: npc_rel['A60'] += 1
					MiraVars['follower'] = 1
					MiraVars['follow_time'] = 2
					if ($clothingworntype = 'nude' or PCloswimwear = 1):
						gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber
						gs 'underwear', 'wear'
					end
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/girls_go.jpg"></center>'
					'You go with Mira through the dense undergrowth to the hidden meadow. Along the way, she merrily tells stories from her past city life.'

					act 'Continue':
						gs 'miroslava', 'exit'
						gt 'gad_meadow', 'start'
					end
				end

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/pc/reactions/speak_to_the_hand.jpg"></center>'
					'You deny Mira, saying that you don''t want to right now.'

					act 'Continue': gt 'miroslava', 'start'
				end

			elseif (temp_rand = 6 or temp_rand = 7) and locat['A60'] ! 51 and locat['A60'] ! 60 and sunWeather = 1 and temper >= 15 and month >= 5 and month <= 9 and MiraVars['follow_time'] = 0 and hour < 18:
				menu_off = 1
				*clr & cla
				minut += 1
				gs 'stat'
				gs 'miroslava', 'miraclothes'
				'"<<$pcs_nickname>>, do you want to go to the river?" - Mira asks. "Let''s go swim and sunbathe."'

				act 'Agree':
					*clr & cla
					minut += 15
					if npc_rel['A60'] < 30: npc_rel['A60'] += 1
					MiraVars['follower'] = 1
					MiraVars['follow_time'] = 2
					if ($clothingworntype = 'nude' or PCloswimwear = 1):
						gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber
						gs 'underwear', 'wear'
					end
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/girls_go.jpg"></center>'
					'You decided to go with Mira to the village beach, and all the way, she goes, merrily chattering and telling stories.'

					act 'Continue':
						gs 'miroslava', 'exit'
						gt 'gad_beach', 'start', 1
					end
				end

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/pc/reactions/speak_to_the_hand.jpg"></center>'
					'You tell Mira that you don''t feel like going to the river now.'

					act 'Continue': gt 'miroslava', 'start'
				end

			elseif temp_rand = 8 or temp_rand = 9:
				menu_off = 1
				*clr & cla
				minut += 1
				MiraVars['follow_time'] = 1
				gs 'stat'
				gs 'miroslava', 'miraclothes'
				'Mira wants to chat with you.'
				'"<<$pcs_nickname>>, do you want to just chat a little?" Mira asks.'

				act 'Chat':gt 'miroslava', 'miratalk'

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira.jpg"></center>'
					'"Not right now, Mira," you say. "I''m not in the mood to talk right now."'

					act 'Continue': gt 'miroslava', 'start'
				end

			elseif temp_rand > 10 and locat['A60'] ! 60 and hour >= 20 and sunWeather = 1 and MiraVars['follow_time'] = 0 and MiraVars['QW'] > 0:
				menu_off = 1
				*clr & cla
				minut += 1
				MiraVars['follower'] = 1
				MiraVars['follow_time'] = 2
				if ($clothingworntype = 'nude' or PCloswimwear = 1):
					gs 'clothing', 'wear', $lastwornclothingtype, lastwornclothingnumber
					gs 'underwear', 'wear'
				end
				gs 'stat'
				gs 'miroslava', 'miraclothes'

				'"<<$pcs_nickname>>, let''s hang out with those guys and drink a little?" Mira asks you. "I''m bored and want to party."'

				act 'Agree':
					minut += 15
					gs 'miroslava', 'exit'
					if MiraVars['QW'] >= 16 and GadBoy['river_gang'] = 2:
						gt 'mitkabuh_group'
					else
						gt 'mitkabuh'
					end
				end

				act 'Refuse':
					*clr & cla
					minut += 1
					npc_rel['A60'] -= 1
					gs 'stat'

					'<center><img <<$set_imgh>> src="images/pc/reactions/speak_to_the_hand.jpg"></center>'
					'You deny Mira, saying that you don''t want to right now.'

					act 'Continue': gt 'miroslava', 'start'
				end
			end
			killvar 'temp_rand'
		end

		if MiraVars['QW'] = 20 and locat['A60'] ! 60 and hour < 19 and month >= 5 and month <= 9:
			act '<b>Make your third wish</b>': gt 'miroslava', 'third_wish'
		end

		!if hour = 23:
		if hour = 23:
			menu_off = 1
			*clr & cla
			minut += 5
			gs 'stat'
			if locat['A60'] = 10:
				gs 'miroslava', 'miraclothes'
				'"<<$pcs_nickname>>, you''re fun to be with, but it''s late. I gotta get to bed. Dad has chores for me to work on tomorrow." Mira tells you.'
			else
				if locat['A60'] = 51:
					if $clothingworntype ! 'nude':'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_go_home.jpg"></center>'
					if $clothingworntype = 'nude':'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_go_home_nude.jpg"></center>'
				else
					gs 'miroslava', 'miraclothes'
				end

				'"<<$pcs_nickname>>, you''re fun to be with, but I gotta get home and get to bed. My dad has chores for me to work on tomorrow." Mira tells you.'
			end

			if $clothingworntype = 'nude':
				gs 'clothing', 'wear_last_worn'
				gs 'underwear', 'wear'
			end

			act 'Go back to the village':
				gs 'miroslava', 'exit'
				gt 'Gadukino'
			end
		end
	end
end




if $ARGS[0] = 'cattle_chore_acts':
	act 'Talk to Mira':
		*clr & cla
		menu_off = 1
		minut += 60
		if temper >= 25 and sunWeather = 1:pcs_hydra -= 12
		if npc_rel['A60'] < 50: npc_rel['A60'] += 1
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/graze_cow_mira.jpg"></center>'
		'You chat with Mira for an hour. You feel like your relationship with her has improved.'

		if hour < 13:
			act 'Continue': gt 'gad_field', 'cow'
		elseif hour < 16:
			act 'Continue': gt 'gad_field', 'cow2'
		else
			act 'Continue': gt 'gad_field', 'cow3'
		end
	end

	if hour < 13 or hour >= 16:
		act 'Go for a run on the field':
			*clr & cla
			menu_off = 1
			minut += 60
			fat -= 5
			gs 'exp_gain', 'run', 1
			gs 'sweat', 'add', 10
			pcs_mood += 5
			if temper >= 25 and sunWeather = 1: pcs_hydra -= 24
			gs 'stat'

			'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/graze_cow_run_mira.jpg"></center>'
			'You spend the next hour running around the field with Mira.'

			if hour >= 16:
				act 'Continue': gt 'gad_field', 'cow3'
			else
				act 'Continue': gt 'gad_field', 'cow'
			end
		end

		if temper >= 15 and sunWeather = 1:
			act 'Tan by the field':
				menu_off = 1
				*clr & cla
				minut += 60
				pcs_mood += 10
				pcs_tan += 1
				gs 'sweat', 'add', 10
				gs 'stat'
				'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/graze_cow_sun_mira.jpg"></center>'
				'You lie down next to Mira and tan together in the sun.'

				if hour >= 16:
					act 'Continue': gt 'gad_field', 'cow3'
				else
					act 'Continue': gt 'gad_field', 'cow'
				end
			end
		end

	elseif temper >= 15 and sunWeather = 1:
		if pcs_stam >= (5 * (10 - sport_clothes_exercise_bonus)) / 2:
			act 'Swim in the nearby river':
				menu_off = 1
				*clr & cla
				gs 'exercise', 'tier1', 15, 'stren', 'stren'
				cumspclnt = 4 & gs 'cum_cleanup'
				pcs_sweat = 10 + rand(0, 4)
				pcs_mood += 5
				if pcs_inhib < 50: inhib_exp += rand(1, 2)
				gs 'stat'

				'<center><img <<$set_imgh>> src="images/locations/gadukino/village/graze_cow_river_mira.jpg"></center>'
				'You wade in the river, splashing around with Mira is a lot of fun.'
				if deodorant_on = 1: gs 'sweat', 'remove_deo' & '<br>Your deodorant gets washed away in the water.'

				act 'Continue': gt 'gad_field', 'cow2'
			end
		end

		act 'Tan by the river':
			menu_off = 1
			*clr & cla
			minut += 30
			gs 'sweat', 'add', 10
			pcs_mood += 5
			pcs_tan += 1
			gs 'stat'
			'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/graze_cow_sun_mira2.jpg"></center>'
			'You lie down next to Mira and tan together in the sun.'

			act 'Continue': gt 'gad_field', 'cow2'
		end
	end

	act 'Depart': gt 'gad_field', 'field'
end


if $ARGS[0] = 'walk_together':
	menu_off = 1
	if daystart < MiraVars['emb_day']:
		minut += 5
		gs 'stat'
		'<center><img <<$set_imgh>> src="images/characters/gadukino/mira/mira_shy.jpg"></center>'
		'You ask Mira to stroll around the village, but Mira only shakes her head, saying she is too ashamed to leave the house.'

