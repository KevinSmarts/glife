# restoranM

$location_type = 'public_indoors'
menu_off = 1

if $ARGS[0] = 'start':
	minut += 30

	'You arrive at the restaurant and sit at a table. <<$npcdesc>> orders a meal and good wine. You have to wait a little until the food arrives.'
	'<<$npcdesc>> tells you an anecdote:<br>'
	gs 'anekdot'
	*nl

	if npc_gentle[$npcID] = 1:
		if npc_dates[$npcID] > 25: gs 'boylove', 'tits'
		if npc_dates[$npcID] > 30: gs 'boylove', 'figure'
	elseif npc_gentle[$npcID] = 0:
		if npc_dates[$npcID] > 20: gs 'boylove', 'tits'
		if npc_dates[$npcID] > 25: gs 'boylove', 'figure'
	else
		if npc_dates[$npcID] > 15: gs 'boylove', 'tits'
		if npc_dates[$npcID] > 20: gs 'boylove', 'figure'
	end


	act 'Laugh': npc_rel[$npcID] += rand(0, 1) & xgt 'restoranM', 'a'
	act 'Smile': xgt 'restoranM', 'a'
	act 'It''s not funny': npc_rel[$npcID] -= rand(0, 1) & xgt 'restoranM', 'a'
end

if $ARGS[0] = 'a':
	minut += 30
	gs 'drugs', 'alcohol', 'wine'
	'When your food arrives, <<$npcdesc>> pours you a glass of wine and proposes a toast to love.'

	act 'Eat': xgt 'restoranM', 'b'
end

if $ARGS[0] = 'b':
	$loc_arg = 'b'
	$loc = 'restoranM'


	gs 'food', 'm_meal'
	gs 'drugs', 'alcohol', 'wine'
	gs 'stat'
	'After you finish your meal and empty the wine, <<$npcdesc>> offers to take you to his home.'

	act 'Go Home':gt 'sexm', 'start'
end

--- restoranM ---------------------------------

