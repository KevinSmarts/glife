	if $ARGS[1] = '58_estate':
		!!Parents apartment
		!!Garages
		!1Luda''s apartment
		!!Shulgin''s Apartment
	elseif $ARGS[1]= 'commercial':
	elseif $ARGS[1]= 'industrial':
	elseif $ARGS[1] = 'market':
	elseif $ARGS[1] = 'park':
	elseif $ARGS[1] = 'train_station':
