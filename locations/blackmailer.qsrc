	if blackmailQW['escape'] = -1: blackmailQW['escape'] = 0
	blackmailQW['next_payment'] = (rand(50, 100) + (blackmailQW['total_payment'] / 50 ) / (1 + blackmailQW['total_payment'] / 20000)) * 10
