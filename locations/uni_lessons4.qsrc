			gs 'willpower', 'misc', 'self', 'medium'
			if will_cost <= pcs_willpwr:
				act 'Keep using your phone (<<will_cost>> Willpower)':
					*clr & cla
					gs 'willpower', 'pay', 'self'
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/locations/city/island/university/classroom/phone.jpg"></center>'
					'You ignore her and keep using your phone as she shakes her head and goes back to her lecture.'
					act 'Wait for the end of the lesson': gs 'uni_lessonsev1', 'anatomy_and_physiology'
				end
			else
				act 'Keep using your phone (<font color="red"><<will_cost>> Willpower</font>)': '<br><font color="red">You don''t have enough willpower to use this action.</font>'
			end
		else
			'You play on your phone for the duration of class. You play a few games and text a few friends, all under Miss Marinova''s oblivious nose.'
			act 'Wait for the end of the lesson': gs 'uni_lessonsev2', 'anatomy_and_physiology'
		end
	end
end

