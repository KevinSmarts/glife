if $ARGS[0] = 'hair_length_veryshort':
	if pcs_hairlng <= 30:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_length_short':
	if pcs_hairlng >= 31 and pcs_hairlng <= 80:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_length_chin':
	if pcs_hairlng >= 81 and pcs_hairlng <= 160:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_length_shoulder':
	if pcs_hairlng >= 161 and pcs_hairlng <= 260:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_length_bra':
	if pcs_hairlng >= 261 and pcs_hairlng <= 400:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_length_long':
	if pcs_hairlng >= 401:
		result = 1
	end
	exit
end


if $ARGS[0] = 'hair_pubes_shaven':
	if pcs_pubes <= 3:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_pubes_stubble':
	if pcs_pubes => 4 and pcs_pubes <= 10:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_pubes_patch':
	if pcs_pubes >= 11 and pcs_pubes <= 15:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_pubes_trimmed':
	if pcs_pubes >= 16 and pcs_pubes <= 25:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_pubes_bush':
	if pcs_pubes >= 25 and pcs_pubes <= 30:
		result = 1
	end
	exit

elseif $ARGS[0] = 'hair_pubes_untrimmed':
	if pcs_pubes >= 31:
		result = 1
	end
	exit

!! needs to be finished
elseif $ARGS[0] = 'hair_pubes_styled':
	if pcs_pubes >= 16 and pcs_pubes <= 25:
		if (pubestyle >= 2 and pubestyle <= 9) or (pubestyle >= 12 and pubestyle <= 14):
			result = 1
		end
	end
	exit
end


