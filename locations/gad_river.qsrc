				gs 'dinsex','vaginal_sex',20,'sub','gangbang'
				gs 'dinsex','sexcum'
			else
				gs 'dinSex','boy_wants_anal','','lubri'
				gs 'dinsex','analsex',20,'sub','gangbang'
			end
