			gs 'arousal', 'anal', 20, 'gangbang', 'sub'
			gs 'arousal', 'anal', 20, 'gangbang', 'sub'
			gs 'arousal', 'anal', 20, 'gangbang', 'sub'
			gs 'arousal', 'end'
			gs 'boyStat', 'A63'
