if $ARGS[0] = 'food':
	gs 'shortgs', 'setloc', 'pushkin_ballet_secrets', $ARGS[0] 
	$location_type = 'public_indoors'
	$setloc['StageTitle'] = 'Food Court'
	$setloc['StageImage'] =	'<<$default_img_path>>food_court.jpg'
	$location_type = 'public_indoors'
	gs 'themes', 'indoors'
