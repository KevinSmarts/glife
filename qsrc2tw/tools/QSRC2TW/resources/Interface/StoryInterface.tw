:: StoryInterface
<style id="userConfiguredStyle"></style>
<style id="qspStyles" data-init-passage="UIUserSettings"></style>
<div id="interface" class="grid-stack">
	<div
		class="grid-stack-item"
		gs-h="5"
		gs-w="3"
		gs-x="9"
		gs-y= "0"
	>
		<div class="grid-stack-item-content" id="sidebar" data-passage="Sidebar">Sidebar</div>
	</div>
	<div
		class="grid-stack-item"
		gs-h="4"
		gs-w="9"
		gs-x="0"
		gs-y= "0"
	>
		<div class="grid-stack-item-content" id="passages">passages</div>
	</div>
	<div
		class="grid-stack-item"
		gs-w="7"
		gs-x="0"
		gs-y= "4"
	>
		<div class="grid-stack-item-content" id="actions" data-passage="Actions">Actions</div>
	</div>
	<div
		class="grid-stack-item"
		gs-x="8"
		gs-y= "4"
	>
		<div class="grid-stack-item-content" id="topbar" data-passage="Topbar">topbar</div>
	</div>
	<div
		class="grid-stack-item"
		gs-x="7"
		gs-y= "4"
	>
		<div class="grid-stack-item-content" id="debugTools" data-passage="DebugTools">DebugTools</div>
	</div>
</div>
