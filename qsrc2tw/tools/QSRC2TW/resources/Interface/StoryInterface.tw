:: StoryInterface
<style id="userConfiguredStyle"></style>
<style id="qspStyles" data-init-passage="UIUserSettings"></style>
<div id="interface" class="grid-stack">
	<div class="grid-stack-item"><div class="grid-stack-item-content" id="sidebar" data-passage="Sidebar">Sidebar</div></div>
	<div class="grid-stack-item"><div class="grid-stack-item-content" id="passages">passages</div></div>
	<div class="grid-stack-item"><div class="grid-stack-item-content" id="actions" data-passage="Actions">Actions</div></div>
	<div class="grid-stack-item"><div class="grid-stack-item-content" id="topbar" data-passage="Topbar">topbar</div></div>
	<div class="grid-stack-item"><div class="grid-stack-item-content" id="debugTools" data-passage="DebugTools">DebugTools</div></div>
</div>
