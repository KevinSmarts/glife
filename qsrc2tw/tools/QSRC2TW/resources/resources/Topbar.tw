:: Topbar[include]
<div class="buttons">

	<<id 'buttonBack'>>
		<<if State.length >= 2>>
			<<button '🡄'>>
				<<run Engine.backward()>>
			<</button>>
		<<else>>
			<<class 'disabled'>>
				<<button '🡄'>><</button>>
			<</class>>
		<</if>>
	<</id>>
	<<id 'buttonForward'>>
		<<if State.length !== State.size>>
			<<button '🡆'>>
				<<run Engine.forward()>>
			<</button>>
		<<else>>
			<<class 'disabled'>>
				<<button '🡆'>><</button>>
			<</class>>
		<</if>>
	<</id>>


	<<id 'buttonSave'>>
		<<button '🖫'>>
			<<run UI.saves();>>
		<</button>>
	<</id>>

	<<id 'buttonSettings'>>
		<<button '🖹'>>
			<<run Dialog.setup("Settings", "uiSettings");Dialog.wiki(Story.get("UISettingsDialog").processText());Dialog.open();>>
		<</button>>
	<</id>>

	<<id 'buttonRestart'>>
		<<button '⭯'>>
			<<run UI.restart();>>
		<</button>>
	<</id>>
</div>
