:: Topbar[include]
<div class="buttons">

	<<if State.length >= 2>>
		<<button '🡄'>>
			<<run Engine.backward()>>
		<</button>>
	<<else>>
		<<class 'disabled'>>
			<<button '🡄'>><</button>>
		<</class>>
	<</if>>
	<<if State.length !== State.size>>
		<<button '🡆'>>
			<<run Engine.forward()>>
		<</button>>
	<<else>>
		<<class 'disabled'>>
			<<button '🡆'>><</button>>
		<</class>>
	<</if>>


	<<button '🖫'>>
		<<run UI.saves();>>
	<</button>>

	<<button '🖹'>>
		<<run Dialog.setup("Settings", "uiSettings");Dialog.wiki(Story.get("UISettingsDialog").processText());Dialog.open();>>
	<</button>>

	<<button '⭯'>>
		<<run UI.restart();>>
	<</button>>
</div>